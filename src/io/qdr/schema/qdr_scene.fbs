namespace quader.qdr.fb;

enum EntityKind : ubyte {
  Empty = 0,
  Mesh = 1,
  Light = 2,
  Generic = 3,
  Instance = 4,
  Curve = 5
}

enum MeshCollisionType : ubyte {
  Box = 0,
  Sphere = 1,
  Cylinder = 2,
  ConvexHull = 3,
  Mesh = 4
}

enum MeshPhysicsBodyType : ubyte {
  StaticBody = 0,
  RigidBody = 1
}

enum LightType : ubyte {
  Directional = 0,
  Point = 1,
  Spot = 2
}

enum LightUnit : ubyte {
  Simple = 0,
  Lumens = 1,
  Candela = 2
}

enum LightColorMode : ubyte {
  Color = 0,
  ColorTemperature = 1
}

enum LightSourcePreset : ubyte {
  Custom = 0,
  Candle = 1,
  Incandescent40W = 2,
  Incandescent60W = 3,
  Incandescent75W = 4,
  Incandescent100W = 5,
  Halogen80W = 6,
  DecorativeLed = 7,
  WarmLed = 8,
  WarmWhiteLed = 9,
  NeutralLed = 10,
  DaylightLed = 11,
  CoolDaylightLed = 12,
  WarmFluorescent36W = 13,
  NeutralFluorescent36W = 14,
  DaylightFluorescent36W = 15,
  HighPressureSodium100W = 16,
  MercuryVapor80W = 17,
  MetalHalide400W = 18,
  StudioTungsten = 19,
  SunriseSunset = 20,
  MiddaySun = 21,
  Daylight = 22,
  Overcast = 23,
  OutdoorShade = 24,
  BlueSky = 25
}

enum SceneToneMapping : ubyte {
  Linear = 0,
  AcesLegacy = 1,
  Aces = 2,
  Filmic = 3,
  DisplayRange = 4,
  Agx = 5
}

enum TextureUsage : ubyte {
  Unknown = 0,
  BaseColor = 1,
  Normal = 2,
  Roughness = 3,
  Metallic = 4,
  Curvature = 5,
  Thickness = 6,
  AmbientOcclusion = 7,
  Position = 8,
  Id = 9,
  Mask = 10
}

enum TextureColorSpace : ubyte {
  Linear = 0,
  Srgb = 1
}

enum SurfaceShading : ubyte {
  Flat = 0,
  Smooth = 1,
  Authored = 2
}

enum GeometryKind : ubyte {
  CompiledMesh = 0,
  AuthoredPolygon = 1
}

enum ProjectAssetKind : ubyte {
  Unknown = 0,
  Material = 1,
  Texture = 2,
  Model = 3
}

struct Vec2 {
  x:float;
  y:float;
}

struct Vec3 {
  x:float;
  y:float;
  z:float;
}

struct MeshVertex {
  position:Vec3;
  normal:Vec3;
  uv:Vec2;
  rgba:uint;
}

struct MeshPrimitive {
  index_offset:uint;
  index_count:uint;
  material_slot:uint;
}

struct MeshTextureMappingVertex {
  carrier_00:float;
  carrier_01:float;
  carrier_10:float;
  carrier_11:float;
  geometric_normal:Vec3;
}

struct PolygonVertex {
  id:uint;
  position:Vec3;
}

struct PolygonEdge {
  a:uint;
  b:uint;
}

struct MaterialSlotBinding {
  slot:uint;
  material_id:ulong;
}

table ProjectMaterialSlotBinding {
  slot:uint;
  project_material_id:string;
}

table GeometryPayload {
  kind:GeometryKind = CompiledMesh;
  // Reader-only schema 1-3 authored-topology representation. Current writers
  // leave the CSR fields through hard_normal_edges empty and use
  // authored_payload instead.
  next_vertex_id:uint = 1;
  next_face_id:uint = 1;
  polygon_vertices:[PolygonVertex];
  face_ids:[uint];
  face_vertex_offsets:[uint];
  face_vertices:[uint];
  face_uv_offsets:[uint];
  face_uvs:[Vec2];
  face_material_slots:[uint];
  face_shading:[SurfaceShading];
  hard_normal_edges:[PolygonEdge];
  mesh_vertices:[MeshVertex];
  mesh_indices:[uint];
  mesh_primitives:[MeshPrimitive];
  authored_payload:[ubyte];
  mesh_texture_mapping:[MeshTextureMappingVertex];
}

table MeshAsset {
  id:ulong;
  name:string;
  has_stable_cpu_topology:bool = true;
  has_authored_polygon_document:bool = false;
  geometry_chunk_id:ulong;
}

table CurveAsset {
  id:ulong;
  name:string;
  authored_payload:[ubyte] (required);
}

table TextureSlotBinding {
  slot:string;
  texture_id:ulong;
}

enum MaterialDiffuseModel : ubyte {
  Burley = 0,
  Lambert = 1
}

table MaterialAsset {
  id:ulong;
  name:string;
  base_color:Vec3;
  roughness:float = 1.0;
  metallic:float = 0.0;
  texture_slots:[TextureSlotBinding];
  node_graph_reserved:bool = true;
  diffuse_model:MaterialDiffuseModel = Burley;
}

table TextureAsset {
  id:ulong;
  name:string;
  usage:TextureUsage = Unknown;
  color_space:TextureColorSpace = Srgb;
  width:uint;
  height:uint;
  source_path:string;
  generated:bool = false;
}

table TransformComponent {
  position:Vec3;
  rotation_euler:Vec3;
  scale:Vec3;
  custom_pivot:bool = false;
}

table TextureMappingComponent {
  sampling_from_local:[float];
}

table VisibilityComponent {
  visible:bool = true;
  selectable:bool = true;
}

table LockComponent {
  locked:bool = false;
}

table ModelingObjectComponent {
  object_id:int = -1;
  material_slot:uint;
  sdk_owned:bool = false;
  local_frame_version:uint = 0;
}

table MeshComponent {
  mesh:ulong;
  editor_only:bool = false;
  cast_shadows:bool = true;
  double_sided:bool = false;
  generate_collisions:bool = true;
  collision_type:MeshCollisionType = Box;
  display_collision:bool = false;
  body_type:MeshPhysicsBodyType = StaticBody;
}

table CurveComponent {
  curve:ulong;
  solidify:bool = false;
  solidify_resolution:int = 8;
  solidify_radius:float = 0.1;
}

table MaterialComponent {
  material:ulong;
  material_slots:[MaterialSlotBinding];
  project_material_id:string;
  project_material_slots:[ProjectMaterialSlotBinding];
}

table LightComponent {
  type:LightType = Directional;
  color:Vec3;
  intensity:float = 1.0;
  range:float = 10.0;
  casts_shadows:bool = false;
  distance_attenuation:float = 2.0;
  light_unit:LightUnit = Simple;
  color_mode:LightColorMode = Color;
  color_temperature_kelvin:float = 6500.0;
  source_preset:LightSourcePreset = Custom;
}

table SceneEnvironmentSettings {
  environment_id:string;
  enabled:bool = true;
  show_background:bool = true;
  clear_color:Vec3;
  intensity:float = 1.0;
  background_intensity:float = 1.0;
  rotation_y:float = 0.0;
}

table SceneCameraSettings {
  aperture:float = 16.0;
  shutter_speed:float = 0.008;
  sensitivity:float = 100.0;
  near_plane:float = 0.05;
  far_plane:float = 1000.0;
  use_exposure:bool = true;
}

table ScenePostProcessSettings {
  enabled:bool = true;
  anti_aliasing:bool = true;
  ambient_occlusion:bool = false;
  ambient_occlusion_intensity:float = 1.0;
  ambient_occlusion_radius:float = 0.3;
  bloom:bool = false;
  bloom_strength:float = 0.1;
  dithering:bool = true;
  tone_mapping:SceneToneMapping = Aces;
}

table SceneFogSettings {
  enabled:bool = false;
  distance:float = 0.0;
  cut_off_distance:float = 0.0;
  maximum_opacity:float = 1.0;
  height:float = 0.0;
  height_falloff:float = 1.0;
  color:Vec3;
  density:float = 0.1;
  in_scattering_start:float = 0.0;
  in_scattering_size:float = -1.0;
  color_from_environment:bool = false;
}

table SceneSettingsComponent {
  environment:SceneEnvironmentSettings;
  camera:SceneCameraSettings;
  post_process:ScenePostProcessSettings;
  fog:SceneFogSettings;
}

table InstanceDefinitionComponent {
}

table InstanceOccurrenceComponent {
  definition:ulong;
}

table Entity {
  id:ulong;
  uuid:string;
  editor_object_id:ulong;
  name:string;
  kind:EntityKind = Generic;
  parent:ulong;
  transform:TransformComponent;
  visibility:VisibilityComponent;
  lock:LockComponent;
  modeling_object:ModelingObjectComponent;
  mesh:MeshComponent;
  material:MaterialComponent;
  light:LightComponent;
  // Legacy reader-only wrapper fields; schema 16 stores settings on ScenePayload.
  scene_root:bool = false;
  scene_settings:SceneSettingsComponent;
  instance_definition:InstanceDefinitionComponent;
  instance_occurrence:InstanceOccurrenceComponent;
  layer_id:ulong;
  texture_mapping:TextureMappingComponent;
  curve:CurveComponent;
}

table SceneLayer {
  id:ulong;
  name:string;
  visible:bool = true;
  wireframe_color:Vec3;
  locked:bool = false;
}

table ViewportCameraPose {
  eye:Vec3;
  target:Vec3;
  up:Vec3;
}

// Legacy read-only compatibility record. New writers leave ScenePayload.objects
// absent; Entity is the sole scene-object truth.
table ObjectRecord {
  editor_object_id:ulong;
  scene_entity:ulong;
  mesh:ulong;
  material:ulong;
  modeling_object:int = -1;
  authored_name:string;
  visible:bool = true;
  material_slot:uint;
  project_material_id:string;
}

table ProjectAssetDependency {
  stable_id:string;
  project_relative_path:string;
  kind:ProjectAssetKind = Unknown;
}

table ScenePayload {
  scene_id:ulong;
  scene_name:string;
  meshes:[MeshAsset];
  materials:[MaterialAsset];
  textures:[TextureAsset];
  entities:[Entity];
  objects:[ObjectRecord];
  project_asset_dependencies:[ProjectAssetDependency];
  layers:[SceneLayer];
  viewport_camera_pose:ViewportCameraPose;
  curves:[CurveAsset];
  // Required by schema-16 domain validation; optional on wire for older files.
  scene_settings:SceneSettingsComponent;
  root_entities:[ulong];
}

root_type ScenePayload;
file_identifier "QDRS";
