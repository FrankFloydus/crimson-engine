material {
    name : QuaderLitPbrPreview,
    shadingModel : lit,
    parameters : [
        {
            type : float4,
            name : albedo
        },
        {
            type : sampler2d,
            name : albedoTexture
        },
        {
            type : bool,
            name : useAlbedoTexture
        },
        {
            type : float,
            name : roughness
        },
        {
            type : sampler2d,
            name : roughnessTexture
        },
        {
            type : bool,
            name : useRoughnessTexture
        },
        {
            type : float,
            name : metallic
        },
        {
            type : sampler2d,
            name : metallicTexture
        },
        {
            type : bool,
            name : useMetallicTexture
        },
        {
            type : float,
            name : reflectance
        },
        {
            type : float,
            name : specularFactor
        },
        {
            type : float3,
            name : specularColorFactor
        },
        {
            type : float,
            name : clearCoat
        },
        {
            type : float,
            name : clearCoatRoughness
        }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float4 baseColor = materialParams.albedo;
        if (materialParams.useAlbedoTexture) {
            baseColor = texture(materialParams_albedoTexture, getUV0());
            baseColor.rgb *= baseColor.a;
        }

        float roughness = materialParams.roughness;
        if (materialParams.useRoughnessTexture) {
            roughness *= texture(materialParams_roughnessTexture, getUV0()).r;
        }

        float metallic = materialParams.metallic;
        if (materialParams.useMetallicTexture) {
            metallic *= texture(materialParams_metallicTexture, getUV0()).r;
        }

        material.baseColor = baseColor;
        material.roughness = roughness;
        material.metallic = metallic;
        material.reflectance = materialParams.reflectance;
        material.specularFactor = materialParams.specularFactor;
        material.specularColorFactor = materialParams.specularColorFactor;
        material.clearCoat = materialParams.clearCoat;
        material.clearCoatRoughness = materialParams.clearCoatRoughness;
    }
}
