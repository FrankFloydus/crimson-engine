material {
    name : QuaderLitPbrPreview,
    shadingModel : lit,
    doubleSided : true,
    parameters : [
        {
            type : float4,
            name : albedo
        },
        {
            type : sampler2d,
            name : albedoTexture
        },
        {
            type : bool,
            name : useAlbedoTexture
        },
        {
            type : float,
            name : roughness
        },
        {
            type : sampler2d,
            name : roughnessTexture
        },
        {
            type : bool,
            name : useRoughnessTexture
        },
        {
            type : float,
            name : metallic
        },
        {
            type : sampler2d,
            name : metallicTexture
        },
        {
            type : bool,
            name : useMetallicTexture
        },
        {
            type : float,
            name : reflectance
        },
        {
            type : float,
            name : specularFactor
        },
        {
            type : float3,
            name : specularColorFactor
        },
        {
            type : float,
            name : clearCoat
        },
        {
            type : float,
            name : clearCoatRoughness
        },
        {
            type : float,
            name : opacity
        },
        {
            type : sampler2d,
            name : opacityTexture
        },
        {
            type : bool,
            name : useOpacityTexture
        },
        {
            type : float,
            name : transmission
        },
        {
            type : float,
            name : ior
        },
        {
            type : float3,
            name : absorption
        },
        {
            type : float,
            name : thickness
        },
        {
            type : float,
            name : microThickness
        },
        {
            type : float,
            name : dispersion
        }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float3 baseColor = materialParams.albedo.rgb;
        float opacity = materialParams.opacity;
        if (materialParams.useAlbedoTexture) {
            float4 albedoSample = texture(materialParams_albedoTexture, getUV0());
            baseColor *= albedoSample.rgb;
            opacity *= albedoSample.a;
        }

        if (materialParams.useOpacityTexture) {
            opacity *= texture(materialParams_opacityTexture, getUV0()).r;
        }
        opacity = clamp(opacity, 0.0, 1.0);

        float roughness = materialParams.roughness;
        if (materialParams.useRoughnessTexture) {
            roughness *= texture(materialParams_roughnessTexture, getUV0()).r;
        }

        float metallic = materialParams.metallic;
        if (materialParams.useMetallicTexture) {
            metallic *= texture(materialParams_metallicTexture, getUV0()).r;
        }

        material.baseColor = float4(baseColor * opacity, opacity);
        material.roughness = roughness;
        material.metallic = metallic;
        material.reflectance = materialParams.reflectance;
        material.specularFactor = materialParams.specularFactor;
        material.specularColorFactor = materialParams.specularColorFactor;
        material.clearCoat = materialParams.clearCoat;
        material.clearCoatRoughness = materialParams.clearCoatRoughness;
    }
}
