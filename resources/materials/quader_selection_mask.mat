material {
    name : QuaderSelectionMask,
    shadingModel : unlit,
    blending : opaque,
    depthWrite : true,
    depthCulling : true,
    doubleSided : true
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(1.0);
    }
}
