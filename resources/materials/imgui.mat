material {
    name : ImGuiTexture,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    doubleSided : true,
    requires : [
        uv0,
        color
    ],
    parameters : [
        {
            type : sampler2d,
            name : albedo
        },
        {
            type : float,
            name : encodeToSrgb
        }
    ]
}

fragment {
    vec3 linearToSrgb(vec3 value) {
        vec3 clamped = clamp(value, 0.0, 1.0);
        vec3 lower = clamped * 12.92;
        vec3 higher = 1.055 * pow(clamped, vec3(1.0 / 2.4)) - 0.055;
        return mix(lower, higher, step(vec3(0.0031308), clamped));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 sampled = texture(materialParams_albedo, getUV0());
        sampled.rgb = mix(sampled.rgb, linearToSrgb(sampled.rgb), clamp(materialParams.encodeToSrgb, 0.0, 1.0));
        vec4 color = sampled * getColor();
        material.baseColor = vec4(color.rgb * color.a, color.a);
    }
}
