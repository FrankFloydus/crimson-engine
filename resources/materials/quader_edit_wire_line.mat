material {
    name : QuaderEditWireLine,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : true,
    doubleSided : true,
    vertexDomain : device,
    requires : [
        color,
        custom0,
        custom1,
        custom2,
        custom3,
        custom4
    ],
    variables : [
        lineDistancePixels,
        lineSurfaceDepths
    ],
    parameters : [
        { type : float, name : selectionPass },
        { type : bool, name : sharedPositionsEnabled },
        { type : sampler2d, name : sharedPositions, precision : high },
        {
            type : float,
            name : lineWidth
        },
        {
            type : float,
            name : featherPixels
        },
        {
            type : float,
            name : nearPlane
        },
        {
            type : float,
            name : farPlane
        },
        {
            type : float,
            name : orthographicProjection
        }
    ]
}

vertex {
    #include "overlay_wire_surface_depth.glsl"
    highp vec3 overlayPosition(highp vec3 position) {
        if (materialParams.sharedPositionsEnabled) {
            int index = int(position.x);
            int width = textureSize(materialParams_sharedPositions, 0).x;
            return texelFetch(materialParams_sharedPositions,
                    ivec2(index % width, index / width), 0).xyz;
        }
        return position;
    }

    highp vec4 clippedEndpoint(highp vec4 startView, highp vec4 endView, bool startEndpoint, float nearZ) {
        bool startBehind = startView.z > nearZ;
        bool endBehind = endView.z > nearZ;
        if (startBehind && endBehind) {
            return vec4(1000000.0, 1000000.0, 0.0, 1.0);
        }
        if (startBehind != endBehind) {
            float denominator = endView.z - startView.z;
            float t = abs(denominator) > 0.000001 ? (nearZ - startView.z) / denominator : 0.0;
            t = clamp(t, 0.0, 1.0);
            highp vec4 clipped = mix(startView, endView, t);
            if (startBehind) {
                startView = clipped;
            } else {
                endView = clipped;
            }
        }
        return getClipFromViewMatrix() * (startEndpoint ? startView : endView);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        highp vec4 startWorld = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom0().xyz), 1.0);
        highp vec4 endWorld = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom1().xyz), 1.0);
        highp vec4 startView = getViewFromWorldMatrix() * startWorld;
        highp vec4 endView = getViewFromWorldMatrix() * endWorld;

        vec4 control = getCustom2();
        float side = control.x;
        float cap = control.y;
        bool startEndpoint = control.z < 0.5;
        float nearPlane = max(materialParams.nearPlane, 0.0001);
        float nearZ = -nearPlane;
        highp vec4 clipStart = clippedEndpoint(startView, endView, true, nearZ);
        highp vec4 clipEnd = clippedEndpoint(startView, endView, false, nearZ);
        highp vec4 baseClip = startEndpoint ? clipStart : clipEnd;

        vec2 resolution = max(getResolution().xy, vec2(1.0));
        vec2 startNdc = clipStart.xy / max(abs(clipStart.w), 0.000001);
        vec2 endNdc = clipEnd.xy / max(abs(clipEnd.w), 0.000001);
        vec2 directionPixels = (endNdc - startNdc) * resolution * 0.5;
        float directionLength = length(directionPixels);
        bool endOn = directionLength <= 0.0001;
        vec2 direction = !endOn ? directionPixels / directionLength : vec2(1.0, 0.0);
        vec2 normal = vec2(-direction.y, direction.x);

        float sideDistance = (max(materialParams.lineWidth, 1.0) + max(materialParams.featherPixels, 0.0)) * 0.5;
        vec2 offsetPixels = (normal * side + direction * cap) * sideDistance;
        vec2 offsetDevice = offsetPixels * getResolution().zw * 2.0;
        float reciprocalW = 1.0 / max(abs(baseClip.w), 0.000001);
        highp vec3 baseDevice = baseClip.xyz * reciprocalW;

        float startDepth = clipStart.z / max(abs(clipStart.w), 0.000001);
        float endDepth = clipEnd.z / max(abs(clipEnd.w), 0.000001);
        // Square caps extend in screen space. Extend their depth plane by the
        // same distance so a slanted wire cannot fall behind its own surface.
        float ribbonDepth = endOn ? max(startDepth, endDepth) :
                baseDevice.z + cap * sideDistance * (endDepth - startDepth) / directionLength;
        const float viewDepthBias = 0.04;
        const float maxDeviceDepthOffset = -0.0008;
        float deviceOffset;
        if (materialParams.orthographicProjection > 0.5) {
            float clipRange = max(materialParams.farPlane - nearPlane, 0.000001);
            deviceOffset = -(2.0 * viewDepthBias) / clipRange;
        } else {
            // One conservative pull preserves the projected depth plane.
            // Different endpoint pulls can expose a hidden slanted wire.
            float viewDepth = max(nearPlane, max(abs(clipStart.w), abs(clipEnd.w)));
            deviceOffset = -(2.0 * nearPlane * viewDepthBias) / max(viewDepth * viewDepth, 0.000001);
        }
        deviceOffset = max(deviceOffset, maxDeviceDepthOffset);
        // Filament's DEVICE vertex domain maps OpenGL NDC Z to its reversed
        // device depth after materialVertex. getClipFromViewMatrix() already
        // yields reversed [0, 1] depth, so convert it back to the GL-domain
        // value produced by the former CPU OverlayCameraProjector first.
        // Apply the small bias before converting back toward GL depth near
        // 1.0. Adding it afterward can round it away entirely for distant
        // edges, leaving even a line on its own surface behind scene depth.
        // Hardware clips extrapolated caps; clamping each endpoint here would
        // bend the interior depth plane again after near-plane clipping.
        float biasedReversedDepth = ribbonDepth - deviceOffset * 0.5;
        float deviceDepth = 1.0 - 2.0 * biasedReversedDepth;
        highp vec4 finalDevice = vec4(baseDevice.xy + offsetDevice,
                                     deviceDepth, 1.0);

        material.clipSpaceTransform = mat4(1.0);
        material.clipSpaceTransform[3] = finalDevice;
        float halfLengthPixels = directionLength * 0.5;
        material.lineDistancePixels = vec4(side * sideDistance,
                cap * (halfLengthPixels + sideDistance), halfLengthPixels, biasedReversedDepth);

        highp vec4 support0World = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom3().xyz), 1.0);
        highp vec4 support1World = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom4().xyz), 1.0);
        highp vec4 support0Clip = getClipFromViewMatrix() * getViewFromWorldMatrix() * support0World;
        highp vec4 support1Clip = getClipFromViewMatrix() * getViewFromWorldMatrix() * support1World;
        // Interpolate each incident face independently. Their nearest-depth
        // crease must be selected per fragment, not across the four corners.
        material.lineSurfaceDepths = vec4(
                overlayWireSurfaceDepth(clipStart, clipEnd, support0Clip, finalDevice.xy, ribbonDepth) - deviceOffset * 0.5,
                overlayWireSurfaceDepth(clipStart, clipEnd, support1Clip, finalDevice.xy, ribbonDepth) - deviceOffset * 0.5,
                control.w, 0.0);
    }
}

fragment {
    #include "overlay_line_coverage.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float alphaScale = overlayLineCoverage(variable_lineDistancePixels.xyz,
                materialParams.lineWidth, materialParams.featherPixels);

        // Keep reverse-Z precision through the DEVICE-domain GL-depth remap.
        // The ribbon has w = 1, so this varying retains its screen-linear depth.
        // Preserve the full antialiased width over the wire's own faces while
        // keeping unrelated foreground surfaces in the ordinary depth test.
        gl_FragDepth = max(variable_lineDistancePixels.w,
                max(variable_lineSurfaceDepths.x, variable_lineSurfaceDepths.y));

        vec4 color = getColor();
        color.a *= alphaScale;
        // Mask exactly the authored active ribbon, including its feather, so
        // ordinary/source wires cannot alter that color through alpha blending.
        bool activeWire = variable_lineSurfaceDepths.z > 0.5;
        if (color.a <= 0.0 ||
                (materialParams.selectionPass > 0.5 &&
                 materialParams.selectionPass < 1.5 && activeWire) ||
                (materialParams.selectionPass > 1.5 && !activeWire)) {
            discard;
        }
        material.baseColor = vec4(color.rgb * color.a, color.a);
    }
}
