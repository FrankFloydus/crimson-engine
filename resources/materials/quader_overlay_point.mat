material {
    name : QuaderOverlayPoint,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : true,
    doubleSided : true,
    vertexDomain : device,
    requires : [
        uv0,
        color,
        custom0,
        custom1,
        custom2,
        custom3
    ],
    variables : [
        pointUv,
        pointColor
    ],
    parameters : [
        { type : bool, name : sharedPositionsEnabled },
        { type : sampler2d, name : sharedPositions, precision : high },
        {
            type : float,
            name : componentPass
        },
        {
            type : float,
            name : innerRadius
        },
        {
            type : float,
            name : pointSize
        },
        {
            type : float,
            name : nearPlane
        },
        {
            type : float,
            name : depthBias
        }
    ]
}

vertex {
    highp vec3 overlayPosition(highp vec3 position) {
        if (materialParams.sharedPositionsEnabled) {
            int index = int(position.x);
            int width = textureSize(materialParams_sharedPositions, 0).x;
            return texelFetch(materialParams_sharedPositions,
                    ivec2(index % width, index / width), 0).xyz;
        }
        return position;
    }

    void materialVertex(inout MaterialVertexInputs material) {
        highp vec4 centerWorld = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom0().xyz), 1.0);
        highp vec4 centerView = getViewFromWorldMatrix() * centerWorld;
        float nearPlane = max(materialParams.nearPlane, 0.0001);
        highp vec4 centerClip;
        if (centerView.z > -nearPlane) {
            centerClip = vec4(1000000.0, 1000000.0, 0.0, 1.0);
        } else {
            centerClip = getClipFromViewMatrix() * centerView;
        }

        vec2 corner = material.uv0 - vec2(0.5);
        bool componentPoints = materialParams.componentPass >= 0.0;
        bool componentOutline = componentPoints && mod(materialParams.componentPass, 2.0) < 0.5;
        vec4 appearance = getCustom2();
        float pointSize = max(componentPoints
            ? appearance.x + (componentOutline ? appearance.y : 0.0)
            : materialParams.pointSize, 1.0);
        material.pointColor = componentOutline ? getCustom3() : material.color;
        // Reserve half a physical pixel outside circular markers for coverage.
        // Square vertex markers retain their original quad and hard boundary.
        float quadSize = pointSize + (materialParams.innerRadius > 0.0 ? 1.0 : 0.0);
        vec2 offsetPixels = corner * quadSize;
        vec2 offsetDevice = offsetPixels * getResolution().zw * 2.0;
        float reciprocalW = 1.0 / max(abs(centerClip.w), 0.000001);
        highp vec3 centerDevice = centerClip.xyz * reciprocalW;

        // DEVICE-domain vertices are remapped by Filament from OpenGL NDC Z
        // to reversed depth. Convert clipFromView's already-reversed depth
        // back to OpenGL NDC so that remap happens exactly once.
        // Pull visible handles toward the camera by a fixed view-space amount,
        // then reproject only their depth. Unlike a constant post-projection
        // offset, this decays with distance in perspective and cannot overtake
        // an occluding surface merely because the camera moved farther away.
        float depthBiasUnits = max(materialParams.depthBias, 0.0);
        highp vec4 biasedView = centerView;
        biasedView.z = min(centerView.z + 0.04 * depthBiasUnits, -nearPlane);
        highp vec4 biasedClip = getClipFromViewMatrix() * biasedView;
        float biasedReciprocalW =
            1.0 / max(abs(biasedClip.w), 0.000001);
        float biasedReversedDepth = biasedClip.z * biasedReciprocalW;
        float unbiasedDeviceDepth = 1.0 - 2.0 * centerDevice.z;
        float biasedDeviceDepth = 1.0 - 2.0 * biasedReversedDepth;
        float legacyMaximumPull = depthBiasUnits * nearPlane * 0.0025;
        float deviceDepth = max(
            -1.0,
            max(unbiasedDeviceDepth - legacyMaximumPull, biasedDeviceDepth));
        highp vec4 finalDevice = vec4(centerDevice.xy + offsetDevice,
                                     deviceDepth, 1.0);
        bool wrongClass = componentPoints &&
            abs(appearance.z - floor(materialParams.componentPass * 0.5)) > 0.5;
        if (getCustom1().x < 0.5 || wrongClass ||
            (componentOutline && appearance.y <= 0.0)) {
            finalDevice = vec4(1000000.0, 1000000.0, 0.0, 1.0);
        }

        material.clipSpaceTransform = mat4(1.0);
        material.clipSpaceTransform[3] = finalDevice;
        material.pointUv = vec4(corner * (quadSize / pointSize) + vec2(0.5), 0.0, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec4 color = variable_pointColor;
        if (materialParams.innerRadius > 0.0) {
            float pointSize = max(materialParams.pointSize, 1.0);
            float distancePixels = length(variable_pointUv.xy - vec2(0.5)) * pointSize;
            float outerRadiusPixels = pointSize * 0.5;
            float innerRadiusPixels = saturate(materialParams.innerRadius) * outerRadiusPixels;
            float outerCoverage = saturate(outerRadiusPixels + 0.5 - distancePixels);
            float innerCoverage = saturate(innerRadiusPixels + 0.5 - distancePixels);
            float coverage = max(outerCoverage - innerCoverage, 0.0);
            if (coverage <= 0.0) {
                discard;
            }
            color.a *= coverage;
        }

        material.baseColor = vec4(color.rgb * color.a, color.a);
    }
}
