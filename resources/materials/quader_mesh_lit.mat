material {
    name : QuaderDefaultMeshLit,
    blending : transparent,
    postLightingBlending : opaque,
    depthWrite : true,
    instanced : true,
    flipUV : true,
    shadingModel : lit,
    requires : [
        uv0,
        tangents,
        custom0,
        custom1,
        custom2,
        custom3,
        custom4
    ],
    variables : [
        surfaceGridProjection,
        textureSamplingCorrection,
        quadUvCoordinates,
        quadUvCorrection
    ],
    parameters : [
        {
            type : mat4[64],
            name : textureSamplingFromLocal,
            precision : high
        },
        {
            type : mat3[64],
            name : textureSamplingCofactor,
            precision : high
        },
        {
            type : sampler2d,
            name : baseColorTexture
        },
        {
            type : sampler2d,
            name : roughnessTexture
        },
        {
            type : sampler2d,
            name : metallicTexture
        },
        {
            type : sampler2d,
            name : normalTexture
        },
        {
            type : float4,
            name : baseColorFactor
        },
        {
            type : float,
            name : metallicFactor
        },
        {
            type : float,
            name : roughnessFactor
        },
        {
            type : int,
            name : diffuseModel
        },
        {
            type : float,
            name : normalStrength
        },
        {
            type : float,
            name : normalYSign
        },
        {
            type : float2,
            name : textureTransformCenter
        },
        {
            type : float2,
            name : textureTransformScale
        },
        {
            type : float2,
            name : textureTransformOffset
        },
        {
            type : float,
            name : textureTransformRotationRadians
        },
        {
            type : float4,
            name : surfaceGridMinorColor
        },
        {
            type : float4,
            name : surfaceGridMajorColor
        },
        {
            type : float,
            name : surfaceGridSize
        },
        {
            type : float,
            name : surfaceGridMajorSize
        },
        {
            type : float,
            name : surfaceGridMinorLineThickness
        },
        {
            type : float,
            name : surfaceGridMajorLineThickness
        },
        {
            type : float,
            name : surfaceGridEnabled
        },
        {
            type : float,
            name : instanceEditDim
        },
        {
            type : float,
            name : instanceEditContextStrength
        },
        {
            type : float,
            name : instanceEditContextTintAmount
        },
        {
            type : float,
            name : instanceEditContextDesaturation
        },
        {
            type : float4,
            name : instanceEditContextColor
        }
    ]
}

vertex {
    vec2 generatedTextureUv(highp vec3 position, highp vec3 geometricNormal) {
        // Match the portable generated UV chart, not the surface-grid chart:
        // Quader -> Source (x, -z, y), with dominant-axis ties X, then Y, then Z.
        if (any(isnan(geometricNormal)) || any(isinf(geometricNormal))
                || dot(geometricNormal, geometricNormal) <= 0.000001) {
            geometricNormal = vec3(0.0, 1.0, 0.0);
        }
        highp vec3 sourcePosition = vec3(position.x, -position.z, position.y);
        highp vec3 sourceNormal = vec3(
                geometricNormal.x, -geometricNormal.z, geometricNormal.y);
        highp vec3 dominant = abs(sourceNormal);
        if (dominant.x >= dominant.y && dominant.x >= dominant.z) {
            float side = sourceNormal.x >= 0.0 ? 1.0 : -1.0;
            return vec2(side * sourcePosition.y, -sourcePosition.z) * 0.5;
        }
        if (dominant.y >= dominant.z) {
            float side = sourceNormal.y >= 0.0 ? 1.0 : -1.0;
            return vec2(-side * sourcePosition.x, -sourcePosition.z) * 0.5;
        }
        float side = sourceNormal.z >= 0.0 ? 1.0 : -1.0;
        return vec2(sourcePosition.x, -side * sourcePosition.y) * 0.5;
    }

    void applyTextureSampling(inout MaterialVertexInputs material) {
        int instanceIndex = getInstanceIndex();
        highp mat4 samplingFromLocal =
                materialParams.textureSamplingFromLocal[instanceIndex];
        material.textureSamplingCorrection = vec4(0.0);
        if (samplingFromLocal == mat4(1.0)) {
            return;
        }
        highp vec4 carrier = getCustom1();
        if (all(equal(carrier, vec4(0.0)))) {
            return;
        }

        highp vec3 position = getPosition().xyz;
        highp vec3 geometricNormal = getCustom2().xyz;
        bool linearSampling = mat3(samplingFromLocal) != mat3(1.0);
        highp vec3 samplingNormal =
                materialParams.textureSamplingCofactor[instanceIndex]
                        * geometricNormal;
        // Cofactor magnitude depends on scale squared. Preserve its direction
        // before the canonical chart applies its normal-degeneracy threshold.
        highp float normalMagnitude = max(max(abs(samplingNormal.x),
                                              abs(samplingNormal.y)),
                                         abs(samplingNormal.z));
        samplingNormal = !isnan(normalMagnitude) && !isinf(normalMagnitude)
                        && normalMagnitude > 0.0
                ? samplingNormal / normalMagnitude : vec3(0.0, 1.0, 0.0);
        // Subtract chart coefficients before multiplying by position. This
        // retains small affine changes at distant coordinates and keeps the
        // translation constant across thin faces.
        highp vec2 chartDelta;
        if (linearSampling) {
            highp vec2 deltaX =
                    generatedTextureUv(samplingFromLocal[0].xyz, samplingNormal)
                    - generatedTextureUv(vec3(1.0, 0.0, 0.0), geometricNormal);
            highp vec2 deltaY =
                    generatedTextureUv(samplingFromLocal[1].xyz, samplingNormal)
                    - generatedTextureUv(vec3(0.0, 1.0, 0.0), geometricNormal);
            highp vec2 deltaZ =
                    generatedTextureUv(samplingFromLocal[2].xyz, samplingNormal)
                    - generatedTextureUv(vec3(0.0, 0.0, 1.0), geometricNormal);
            chartDelta = deltaX * position.x + deltaY * position.y
                    + deltaZ * position.z
                    + generatedTextureUv(samplingFromLocal[3].xyz, samplingNormal);
        } else {
            chartDelta = generatedTextureUv(
                    samplingFromLocal[3].xyz, geometricNormal);
        }
        highp vec2 uvCorrection = vec2(
                dot(carrier.xy, chartDelta), dot(carrier.zw, chartDelta));
        if (any(isnan(uvCorrection)) || any(isinf(uvCorrection))) {
            return;
        }
        // Filament already flipped UV0 before this callback. Negating only the
        // V delta lets the existing fragment flip recover UV0 + K * chartDelta.
        material.uv0 += vec2(uvCorrection.x, -uvCorrection.y);
        material.textureSamplingCorrection.x =
                linearSampling ? 1.0 : 0.0;
    }

    void materialVertex(inout MaterialVertexInputs material) {
        applyTextureSampling(material);
        material.quadUvCoordinates = getCustom3();
        material.quadUvCorrection = getCustom4();
        material.textureSamplingCorrection.x = max(
                material.textureSamplingCorrection.x,
                material.quadUvCoordinates.w);
        vec4 projection = getCustom0();
        vec3 worldNormal = getWorldFromModelNormalMatrix() * projection.xyz;
        float normalLengthSquared = dot(worldNormal, worldNormal);
        material.surfaceGridProjection = vec4(
                normalLengthSquared > 0.000001
                        ? worldNormal * inversesqrt(normalLengthSquared)
                        : vec3(0.0, 1.0, 0.0),
                projection.w);
    }
}

fragment {
    #define QUADER_HAS_DIFFUSE_MODEL

    #include "mesh_quad_uv.glsl"
    #include "instance_edit.glsl"

    float surfaceGridFloor(float spacing) {
        return exp2(floor(log2(max(spacing, 0.0001))));
    }

    float surfaceGridLineCoverage(float coord, float spacing, float thicknessValue) {
        float safeSpacing = max(spacing, 0.0001);
        float wrapped = abs(fract(coord / safeSpacing + 0.5) - 0.5) * safeSpacing;
        float thickness = clamp(thicknessValue, 0.05, 8.0);
        float derivativeWidth = fwidth(coord);
        float antialias = clamp(derivativeWidth, safeSpacing * 0.0005, safeSpacing * 0.125);
        float lineWidth = min(antialias * 0.75 * thickness, safeSpacing * 0.125);
        float feather = min(antialias, safeSpacing * 0.125);
        return 1.0 - smoothstep(lineWidth, lineWidth + feather, wrapped);
    }

    float surfaceGridLine(float coord, float spacing, float thicknessValue, float worldPixelWidth) {
        float safeSpacing = max(spacing, 0.0001);
        float minRenderableSpacing = max(worldPixelWidth, 0.0) * 4.0;
        float lodSpacing = max(surfaceGridFloor(max(minRenderableSpacing, safeSpacing)), safeSpacing);
        float nextSpacing = max(lodSpacing * 2.0, lodSpacing + 0.0001);
        float blend = smoothstep(lodSpacing, nextSpacing, minRenderableSpacing);
        float currentCoverage = surfaceGridLineCoverage(coord, lodSpacing, thicknessValue);
        float nextCoverage = surfaceGridLineCoverage(coord, nextSpacing, thicknessValue);
        return mix(currentCoverage, nextCoverage, blend);
    }

    float surfaceGridLineSlotCoverage(
            float coord, float spacing, float thicknessValue, float worldPixelWidth) {
        float safeSpacing = max(spacing, 0.0001);
        float minRenderableSpacing = max(worldPixelWidth, 0.0) * 4.0;
        float lodSpacing = max(surfaceGridFloor(max(minRenderableSpacing, safeSpacing)), safeSpacing);
        float nextSpacing = max(lodSpacing * 2.0, lodSpacing + 0.0001);
        float currentCoverage = surfaceGridLineCoverage(coord, lodSpacing, thicknessValue);
        float nextCoverage = surfaceGridLineCoverage(coord, nextSpacing, thicknessValue);
        return max(currentCoverage, nextCoverage);
    }

    vec3 surfaceGridProjectionWeights(vec3 normal) {
        // Blend line coverage instead of coordinates so curved smooth meshes
        // transition between world projection planes without seams or stubs.
        vec3 weights = abs(normal);
        weights *= weights;
        weights *= weights;
        float weightSum = weights.x + weights.y + weights.z;
        if (weightSum <= 0.000001) {
            return vec3(0.0, 0.0, 1.0);
        }
        return weights / weightSum;
    }

    vec3 surfaceGridFaceProjectionWeights(vec3 normal) {
        // TrenchBroom is Z-up. After conversion to Quader's Y-up coordinates,
        // strict dominant-axis ties resolve Y, then Z, then X.
        vec3 dominant = abs(normal);
        if (dominant.x > dominant.y && dominant.x > dominant.z) {
            return vec3(1.0, 0.0, 0.0);
        }
        if (dominant.z > dominant.y) {
            return vec3(0.0, 0.0, 1.0);
        }
        return vec3(0.0, 1.0, 0.0);
    }

    vec3 surfaceGridPlaneLineCoverages(
            highp vec3 worldPosition,
            float spacing,
            float thicknessValue,
            float worldPixelWidth) {
        vec3 axisCoverages = vec3(
                surfaceGridLine(worldPosition.x, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLine(worldPosition.y, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLine(worldPosition.z, spacing, thicknessValue, worldPixelWidth));
        return vec3(
                max(axisCoverages.y, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.y));
    }

    vec3 surfaceGridPlaneSlotCoverages(
            highp vec3 worldPosition,
            float spacing,
            float thicknessValue,
            float worldPixelWidth) {
        vec3 axisCoverages = vec3(
                surfaceGridLineSlotCoverage(worldPosition.x, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLineSlotCoverage(worldPosition.y, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLineSlotCoverage(worldPosition.z, spacing, thicknessValue, worldPixelWidth));
        return vec3(
                max(axisCoverages.y, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.y));
    }

    vec3 applySurfaceGrid(vec3 baseColor) {
        if (materialParams.surfaceGridEnabled <= 0.5) {
            return baseColor;
        }

        highp vec3 worldPosition = getUserWorldPosition().xyz;
        highp vec3 rasterWorldPosition = getWorldPosition();
        float worldPixelWidth = max(
                length(dFdx(rasterWorldPosition)),
                length(dFdy(rasterWorldPosition)));
        float baseSpacing = max(materialParams.surfaceGridSize, 0.0001);
        float majorSpacing = max(materialParams.surfaceGridMajorSize, baseSpacing);
        vec4 faceProjection = variable_surfaceGridProjection;
        vec3 projectionWeights = faceProjection.w > 0.5
                ? surfaceGridFaceProjectionWeights(faceProjection.xyz)
                : surfaceGridProjectionWeights(
                        getWorldGeometricNormalVector());
        vec3 minorPlaneCoverages = surfaceGridPlaneLineCoverages(
                worldPosition, baseSpacing,
                materialParams.surfaceGridMinorLineThickness,
                worldPixelWidth);
        vec3 majorPlaneCoverages = surfaceGridPlaneLineCoverages(
                worldPosition, majorSpacing,
                materialParams.surfaceGridMajorLineThickness,
                worldPixelWidth);

        float majorSlotThickness = max(
                materialParams.surfaceGridMinorLineThickness,
                materialParams.surfaceGridMajorLineThickness);
        vec3 majorSlotCoverages = surfaceGridPlaneSlotCoverages(
                worldPosition, majorSpacing, majorSlotThickness,
                worldPixelWidth);
        vec3 majorSlotMask = step(vec3(0.000001), majorSlotCoverages);
        float minorLine = dot(
                minorPlaneCoverages * (vec3(1.0) - majorSlotMask),
                projectionWeights);
        float majorLine = dot(majorPlaneCoverages, projectionWeights);

        float majorCoverage = majorLine * materialParams.surfaceGridMajorColor.a;
        float minorCoverage =
                minorLine * materialParams.surfaceGridMinorColor.a;
        float alpha = clamp(minorCoverage + majorCoverage, 0.0, 1.0);
        if (alpha <= 0.000001) {
            return baseColor;
        }
        vec3 gridColor = (materialParams.surfaceGridMinorColor.rgb * minorCoverage
                + materialParams.surfaceGridMajorColor.rgb * majorCoverage) / alpha;
        return mix(baseColor, gridColor, alpha);
    }

    vec2 applyTextureTransform(vec2 uv) {
        vec2 local = (uv - materialParams.textureTransformCenter)
                * materialParams.textureTransformScale;
        float cosine = cos(materialParams.textureTransformRotationRadians);
        float sine = sin(materialParams.textureTransformRotationRadians);
        vec2 rotated = vec2(
                cosine * local.x - sine * local.y,
                sine * local.x + cosine * local.y);
        return materialParams.textureTransformCenter + rotated
                + materialParams.textureTransformOffset;
    }

    vec3 safeTextureNormal(highp vec3 value, vec3 fallback) {
        if (any(isnan(value)) || any(isinf(value))) {
            return fallback;
        }
        highp float magnitude = max(max(abs(value.x), abs(value.y)), abs(value.z));
        if (magnitude <= 1.0e-20) {
            return fallback;
        }
        highp vec3 scaled = value / magnitude;
        return scaled * inversesqrt(dot(scaled, scaled));
    }

    vec3 normalForTextureUv(vec3 normalSample, highp vec2 uv) {
        // Keep the existing interpolated tangent frame for an unchanged chart,
        // including pure texture translations. Bilinear quad correction marks
        // the chart changed so this path derives tangents from the final UV.
        if (variable_textureSamplingCorrection.x <= 0.5
                && materialParams.textureTransformRotationRadians == 0.0
                && all(equal(materialParams.textureTransformScale, vec2(1.0)))) {
            return normalSample;
        }

        // The implicit vertex flip and explicit fragment flip cancel. These
        // final sampled UVs therefore use the same V convention as CPU tangents.
        highp vec2 uvDx = dFdx(uv);
        highp vec2 uvDy = dFdy(uv);
        if (any(isnan(uvDx)) || any(isinf(uvDx))
                || any(isnan(uvDy)) || any(isinf(uvDy))) {
            return normalSample;
        }
        highp float uvMagnitude = max(max(abs(uvDx.x), abs(uvDx.y)),
                                     max(abs(uvDy.x), abs(uvDy.y)));
        if (uvMagnitude <= 1.0e-20) {
            return normalSample;
        }
        uvDx /= uvMagnitude;
        uvDy /= uvMagnitude;
        highp float uvDeterminant = uvDx.x * uvDy.y - uvDx.y * uvDy.x;
        if (abs(uvDeterminant) <= 0.00000001) {
            return normalSample;
        }

        highp vec3 positionDx = dFdx(getWorldPosition());
        highp vec3 positionDy = dFdy(getWorldPosition());
        highp float orientation = uvDeterminant < 0.0 ? -1.0 : 1.0;
        highp vec3 tangent =
                (positionDx * uvDy.y - positionDy * uvDx.y) * orientation;
        highp vec3 bitangent =
                (positionDy * uvDx.x - positionDx * uvDy.x) * orientation;
        highp vec3 normal = getWorldGeometricNormalVector();
        tangent = safeTextureNormal(tangent - normal * dot(normal, tangent),
                                    vec3(0.0));
        bitangent = safeTextureNormal(bitangent, vec3(0.0));
        if (dot(tangent, tangent) <= 0.000001
                || dot(bitangent, bitangent) <= 0.000001) {
            return normalSample;
        }
        highp vec3 crossBitangent = cross(normal, tangent);
        bitangent = crossBitangent
                * (dot(crossBitangent, bitangent) < 0.0 ? -1.0 : 1.0);
        highp vec3 mappedWorldNormal = tangent * normalSample.x
                + bitangent * normalSample.y + normal * normalSample.z;

        // Filament retains an unnormalized, interpolated TBN. Invert that frame
        // instead of transposing it so prepareMaterial reproduces this direction.
        highp mat3 worldTangentFrame = getWorldTangentFrame();
        highp float frameDeterminant = determinant(worldTangentFrame);
        if (isnan(frameDeterminant) || isinf(frameDeterminant)
                || abs(frameDeterminant) <= 0.00000001) {
            return normalSample;
        }
        return safeTextureNormal(inverse(worldTangentFrame) * mappedWorldNormal,
                                 normalSample);
    }

    void material(inout MaterialInputs material) {
        vec2 uv = applyTextureTransform(
                applyQuadUvInterpolation(vec2(getUV0().x, 1.0 - getUV0().y)));
        vec3 normalSample = texture(materialParams_normalTexture, uv).xyz * 2.0 - 1.0;
        normalSample.y *= materialParams.normalYSign;
        normalSample.xy *= clamp(materialParams.normalStrength, -16.0, 16.0);
        normalSample = safeTextureNormal(normalSample, vec3(0.0, 0.0, 1.0));
        normalSample = normalForTextureUv(normalSample, uv);
        material.normal = normalSample;

        prepareMaterial(material);

        vec4 baseSample = texture(materialParams_baseColorTexture, uv);
        float roughnessSample = texture(materialParams_roughnessTexture, uv).r;
        float metallicSample = texture(materialParams_metallicTexture, uv).r;
        vec3 albedo = baseSample.rgb * materialParams.baseColorFactor.rgb;
        float sourceAlpha = baseSample.a * materialParams.baseColorFactor.a;
        float roughness = clamp(
                roughnessSample * materialParams.roughnessFactor, 0.04, 1.0);
        float metallic = clamp(
                metallicSample * materialParams.metallicFactor, 0.0, 1.0);
        float debugMode = floor(getMaterialGlobal0().x + 0.5);

        vec3 baseColor = albedo;
        baseColor = applySurfaceGrid(baseColor);
        vec4 edited = applyInstanceEditContext(
                vec4(baseColor, sourceAlpha), materialParams.instanceEditContextColor,
                materialParams.instanceEditDim * materialParams.instanceEditContextStrength,
                materialParams.instanceEditContextTintAmount,
                materialParams.instanceEditContextDesaturation);
        material.baseColor = vec4(edited.rgb * edited.a, edited.a);
        material.roughness = roughness;
        material.metallic = metallic;

        if (debugMode == 1.0) {
            vec3 diffuseColor = albedo * (1.0 - metallic);
            material.baseColor = vec4(diffuseColor * sourceAlpha, sourceAlpha);
            material.metallic = 0.0;
            material.reflectance = 0.0;
        } else if (debugMode == 2.0) {
            vec3 specularColor = mix(vec3(0.04), albedo, metallic);
            material.baseColor = vec4(specularColor * sourceAlpha, sourceAlpha);
            material.metallic = 1.0;
        }

        vec3 worldNormal = normalize(getWorldTangentFrame() * normalSample);
        vec3 debugColor = albedo;
        if (debugMode == 4.0) {
            debugColor = vec3(roughness);
        } else if (debugMode == 5.0) {
            debugColor = vec3(metallic);
        } else if (debugMode == 6.0) {
            debugColor = worldNormal * 0.5 + 0.5;
        }
        material.postLightingColor = vec4(
                debugColor * sourceAlpha, sourceAlpha);
        material.postLightingMixFactor =
                debugMode >= 3.0 && debugMode <= 6.0 ? 1.0 : 0.0;
    }
}
