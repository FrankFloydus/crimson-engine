material {
    name : QuaderGroundGrid,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    doubleSided : true,
    vertexDomain : device,
    variables : [
        localPosition,
        gridWorldPosition
    ],
    parameters : [
        {
            type : float4,
            name : gridColor
        },
        {
            type : float4,
            name : majorGridColor
        },
        {
            type : float4,
            name : grid1024Color
        },
        {
            type : float4,
            name : originUColor
        },
        {
            type : float4,
            name : originVColor
        },
        {
            type : float3,
            name : cameraPosition
        },
        {
            type : float3,
            name : gridUAxis
        },
        {
            type : float3,
            name : gridVAxis
        },
        {
            type : float,
            name : gridSize
        },
        {
            type : float,
            name : gridIntensity
        },
        {
            type : float,
            name : parentGridSize
        },
        {
            type : float,
            name : lineThickness
        },
        {
            type : float,
            name : majorLineThickness
        },
        {
            type : float,
            name : axisLineThickness
        },
        {
            type : float,
            name : fadeStart
        },
        {
            type : float,
            name : fadeEnd
        },
        {
            type : float,
            name : planeHalfSize
        },
        {
            type : float,
            name : cameraSize
        },
        {
            type : float,
            name : viewportHeight
        },
        {
            type : float,
            name : visibleGridSize
        },
        {
            type : float,
            name : minGridWorldSpacing
        },
        {
            type : float,
            name : analyticGridEnabled
        },
        {
            type : float,
            name : depthBiasAmount
        },
        {
            type : float3,
            name : analyticLineThickness
        }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.localPosition = getPosition();
        highp vec4 worldPosition = getWorldFromModelMatrix() * getPosition();
        material.worldPosition = worldPosition;
        material.gridWorldPosition = worldPosition;
        highp vec4 clipPosition = getClipFromWorldMatrix() * worldPosition;
        if (materialParams.analyticGridEnabled > 0.5) {
            // Hammer's D_DEPTH_BIAS shifts clip depth toward the camera,
            // with the same interpolation W as the original grid plane.
            highp float depth = clamp(clipPosition.z / clipPosition.w, 0.0, 1.0);
            highp float bias = mix(0.000001, materialParams.depthBiasAmount, depth);
            clipPosition.z += clipPosition.w * bias;
        }

        // Filament's DEVICE path applies z = -0.5*z + 0.5 after this
        // transform. Undo that remap in homogeneous coordinates, retaining W.
        highp vec4 devicePosition = vec4(clipPosition.xy,
                1.0 - 2.0 * clipPosition.z, clipPosition.w);
        material.clipSpaceTransform = mat4(0.0);
        material.clipSpaceTransform[3] = devicePosition;
    }
}

fragment {
    float gridLine(float coord, float spacing, float widthScale, float thicknessValue) {
        float safeSpacing = max(spacing, 0.0001);
        float wrapped = abs(fract(coord / safeSpacing + 0.5) - 0.5) * safeSpacing;
        float thickness = clamp(thicknessValue, 0.05, 8.0);
        float antialias = max(fwidth(coord), safeSpacing * 0.001);
        float lineWidth = antialias * max(widthScale, 0.05) * thickness;
        float coverage = 1.0 - smoothstep(lineWidth, lineWidth + antialias, wrapped);
        return coverage;
    }

    float axisLine(float coord) {
        float thickness = clamp(materialParams.axisLineThickness, 0.05, 8.0);
        float antialias = max(fwidth(coord), 0.0001);
        float lineWidth = antialias * 0.9 * thickness;
        float coverage = 1.0 - smoothstep(lineWidth, lineWidth + antialias, abs(coord));
        return coverage;
    }

    vec3 safeNormalize(vec3 value, vec3 fallback) {
        float len = length(value);
        if (len <= 0.000001) {
            return fallback;
        }
        return value / len;
    }

    vec4 analyticGridTier(highp float nearestIndex, highp float mapSpacing,
            highp float derivativeWidth, vec4 gridColor, vec4 majorGridColor,
            vec4 originColor, out float thickness) {
        highp float mapCoordinate = nearestIndex * mapSpacing;
        int lineCoordinate = int(mapCoordinate);
        vec4 color = gridColor;
        thickness = materialParams.analyticLineThickness.x;
        if ((lineCoordinate & 63) == 0) {
            float highlight = 1.0 - clamp((derivativeWidth - 12.0) / 12.0, 0.0, 1.0);
            color = mix(gridColor, majorGridColor, highlight);
            thickness = materialParams.analyticLineThickness.y;
        }
        if ((lineCoordinate & 1023) == 0) {
            color = materialParams.grid1024Color;
            thickness = materialParams.analyticLineThickness.y;
        }
        if (lineCoordinate == 0) {
            color = originColor;
            thickness = materialParams.analyticLineThickness.z;
        }
        return color;
    }

    vec4 analyticGroundGrid(highp vec3 worldPosition, highp vec3 shaderWorldPosition,
            vec3 uAxis, vec3 vAxis, highp vec2 coords) {
        // Grid spacing and the 64/1024 hierarchy use Quader map units.
        highp vec2 mapCoords = coords * 32.0;
        highp float mapSpacing = max(materialParams.gridSize * 32.0, 0.0001);
        highp float inverseSpacing = 1.0 / mapSpacing;
        // Filament's portable material compiler exposes fwidth rather than
        // the explicit coarse derivatives used by the source DXBC shader.
        highp vec2 derivativeWidth = fwidth(mapCoords);
        highp vec4 projectedPosition = getClipFromWorldMatrix() * vec4(shaderWorldPosition, 1.0);
        highp vec2 pixelNdc = projectedPosition.xy / projectedPosition.w;
        highp mat4 userWorldFromClip = getUserWorldFromWorldMatrix() * getWorldFromClipMatrix();
        highp vec3 planeNormal = cross(uAxis, vAxis);
        highp float planeDistance = dot(worldPosition - materialParams.cameraPosition, planeNormal);
        highp vec2 inverseResolution = getResolution().zw;
        vec4 gridColor = materialParams.gridColor;
        vec4 majorGridColor = materialParams.majorGridColor;
        vec4 colorSum = vec4(0.0);
        float coverageSum = 0.0;

        for (int sampleY = -1; sampleY <= 1; ++sampleY) {
            for (int sampleX = -1; sampleX <= 1; ++sampleX) {
                // These are NDC offsets, equivalent to +/-0.125 screen pixel.
                highp vec2 sampleNdc = pixelNdc
                        + vec2(float(sampleX), float(sampleY)) * 0.25 * inverseResolution;
                highp vec4 projectedWorld = userWorldFromClip * vec4(sampleNdc, 1.0, 1.0);
                highp vec3 ray = normalize(projectedWorld.xyz / projectedWorld.w
                        - materialParams.cameraPosition);
                highp vec3 sampleWorld = materialParams.cameraPosition
                        + ray * (planeDistance / dot(ray, planeNormal));
                highp vec2 sampleCoords = vec2(dot(sampleWorld, uAxis), dot(sampleWorld, vAxis)) * 32.0;
                highp vec2 scaledCoords = sampleCoords * inverseSpacing;
                highp vec2 nearestIndex = roundEven(scaledCoords);
                float uThickness;
                float vThickness;
                vec4 uColor = analyticGridTier(nearestIndex.x, mapSpacing, derivativeWidth.x,
                        gridColor, majorGridColor, materialParams.originVColor, uThickness);
                vec4 vColor = analyticGridTier(nearestIndex.y, mapSpacing, derivativeWidth.y,
                        gridColor, majorGridColor, materialParams.originUColor, vThickness);
                // Settings supply ratios against their defaults: (1,1,1)
                // retains Hammer's 0.7-pixel half width for every line tier.
                highp vec2 halfWidth = derivativeWidth * (0.7 * inverseSpacing)
                        * max(vec2(uThickness, vThickness), vec2(0.0001));
                vec2 coverage = vec2(1.0) - clamp(abs(scaledCoords - nearestIndex) / halfWidth,
                        vec2(0.0), vec2(1.0));
                colorSum += coverage.x > coverage.y ? uColor : vColor;
                coverageSum += max(coverage.x, coverage.y);
            }
        }

        // The source shader averages colors and coverage separately.
        vec4 color = colorSum / 9.0;
        color.a *= coverageSum / 9.0;
        return color;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp vec3 shaderWorldPosition = variable_gridWorldPosition.xyz;
        highp vec3 worldPosition = (getUserWorldFromWorldMatrix()
                * vec4(shaderWorldPosition, 1.0)).xyz;
        vec3 safeUAxis = safeNormalize(materialParams.gridUAxis, vec3(1.0, 0.0, 0.0));
        vec3 safeVAxis = safeNormalize(materialParams.gridVAxis, vec3(0.0, 0.0, -1.0));
        vec2 coords = vec2(dot(worldPosition, safeUAxis), dot(worldPosition, safeVAxis));
        vec3 color;
        float alpha;
        if (materialParams.analyticGridEnabled > 0.5) {
            vec4 grid = analyticGroundGrid(worldPosition, shaderWorldPosition,
                    safeUAxis, safeVAxis, coords);
            color = grid.rgb;
            alpha = grid.a;
        } else {
            float baseSpacing = max(materialParams.gridSize, 0.0001);
            float gridValue = max(
                    gridLine(coords.x, baseSpacing, 0.65, materialParams.lineThickness),
                    gridLine(coords.y, baseSpacing, 0.65, materialParams.lineThickness));
            float parentSpacing = max(max(materialParams.parentGridSize, 0.0001), baseSpacing);
            float parentGridValue = max(
                    gridLine(coords.x, parentSpacing, 0.85, materialParams.majorLineThickness),
                    gridLine(coords.y, parentSpacing, 0.85, materialParams.majorLineThickness));

            float majorCoverage = parentGridValue * materialParams.majorGridColor.a;
            float minorCoverage = gridValue * materialParams.gridColor.a * (1.0 - clamp(majorCoverage, 0.0, 1.0));
            alpha = minorCoverage + majorCoverage;
            color = materialParams.gridColor.rgb;
            if (alpha > 0.0) {
                color = (materialParams.gridColor.rgb * minorCoverage
                        + materialParams.majorGridColor.rgb * majorCoverage) / alpha;
            }

            float uAxis = axisLine(coords.y);
            float vAxis = axisLine(coords.x);
            if (uAxis > 0.0 && materialParams.originUColor.a > 0.0) {
                color = mix(color, materialParams.originUColor.rgb, uAxis);
                alpha = max(alpha, uAxis * materialParams.originUColor.a);
            }
            if (vAxis > 0.0 && materialParams.originVColor.a > 0.0) {
                color = mix(color, materialParams.originVColor.rgb, vAxis);
                alpha = max(alpha, vAxis * materialParams.originVColor.a);
            }
            // Orthographic views retain their existing presentation fade.
            vec2 cameraCoords = vec2(
                    dot(materialParams.cameraPosition, safeUAxis),
                    dot(materialParams.cameraPosition, safeVAxis));
            float distanceToCamera = length(coords - cameraCoords);
            float distanceFade = 1.0 - smoothstep(materialParams.fadeStart,
                    materialParams.fadeEnd, distanceToCamera);
            float edgeDistance = max(abs(variable_localPosition.x), abs(variable_localPosition.z));
            float edgeFade = 1.0 - smoothstep(materialParams.planeHalfSize * 0.88,
                    materialParams.planeHalfSize, edgeDistance);
            float fade = clamp(distanceFade * edgeFade, 0.0, 1.0);
            fade += (materialParams.cameraSize + materialParams.viewportHeight
                    + materialParams.visibleGridSize + materialParams.minGridWorldSpacing) * 0.0;
            alpha *= fade;
        }

        alpha = clamp(alpha * materialParams.gridIntensity, 0.0, 1.0);
        if (alpha < 0.002) {
            discard;
        }
        // Filament's transparent blend uses ONE / ONE_MINUS_SRC_ALPHA.
        // Premultiply once to preserve Hammer's SRC_ALPHA blend for RGB.
        material.baseColor = vec4(color * alpha, alpha);
    }
}
