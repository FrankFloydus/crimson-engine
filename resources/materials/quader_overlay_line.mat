material {
    name : QuaderOverlayLine,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    doubleSided : true,
    vertexDomain : device,
    requires : [
        color,
        custom0,
        custom1,
        custom2,
        custom3,
        custom4
    ],
    variables : [
        lineDistancePixels,
        lineSurfaceDepths
    ],
    parameters : [
        { type : bool, name : sharedPositionsEnabled },
        { type : sampler2d, name : sharedPositions, precision : high },
        { type : bool, name : surfaceDepthEnabled },
        { type : float, name : dashPeriodPixels },
        { type : float, name : dashFactor },
        {
            type : float,
            name : lineWidth
        },
        {
            type : float,
            name : featherPixels
        },
        {
            type : float,
            name : nearPlane
        },
        {
            type : float,
            name : depthBias
        },
        {
            type : float,
            name : alphaMultiplier
        }
    ]
}

vertex {
    highp vec3 overlayPosition(highp vec3 position) {
        if (materialParams.sharedPositionsEnabled) {
            int index = int(position.x);
            int width = textureSize(materialParams_sharedPositions, 0).x;
            return texelFetch(materialParams_sharedPositions,
                    ivec2(index % width, index / width), 0).xyz;
        }
        return position;
    }

    bool clipLineToNearPlane(inout highp vec4 startView, inout highp vec4 endView, float nearZ) {
        bool startBehind = startView.z > nearZ;
        bool endBehind = endView.z > nearZ;
        if (startBehind && endBehind) {
            return false;
        }
        if (startBehind != endBehind) {
            float denominator = endView.z - startView.z;
            float t = abs(denominator) > 0.000001 ? (nearZ - startView.z) / denominator : 0.0;
            t = clamp(t, 0.0, 1.0);
            highp vec4 clipped = mix(startView, endView, t);
            clipped.z = nearZ;
            if (startBehind) {
                startView = clipped;
            } else {
                endView = clipped;
            }
        }
        return true;
    }

    highp float surfaceDepth(highp vec4 first, highp vec4 second,
            highp vec4 support, highp vec2 devicePosition, highp float fallbackDepth) {
        // A source face has affine device depth. Homogeneous XYW also handles
        // support points behind the camera; degenerate planes keep line depth.
        first /= max(max(abs(first.x), abs(first.y)), max(abs(first.w), 0.000001));
        second /= max(max(abs(second.x), abs(second.y)), max(abs(second.w), 0.000001));
        support /= max(max(abs(support.x), abs(support.y)), max(abs(support.w), 0.000001));
        highp vec3 firstPoint = first.xyw;
        highp vec3 secondPoint = second.xyw;
        highp vec3 supportPoint = support.xyw;
        highp vec3 secondCrossSupport = cross(secondPoint, supportPoint);
        highp float determinant = dot(firstPoint, secondCrossSupport);
        highp float determinantScale = length(firstPoint) * length(secondPoint) * length(supportPoint);
        if (abs(determinant) <= 0.0000001 * determinantScale) {
            return fallbackDepth;
        }
        highp vec3 plane = (first.z * secondCrossSupport +
                second.z * cross(supportPoint, firstPoint) +
                support.z * cross(firstPoint, secondPoint)) / determinant;
        return dot(plane, vec3(devicePosition, 1.0));
    }

    void materialVertex(inout MaterialVertexInputs material) {
        highp vec4 startWorld = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom0().xyz), 1.0);
        highp vec4 endWorld = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom1().xyz), 1.0);
        highp vec4 startView = getViewFromWorldMatrix() * startWorld;
        highp vec4 endView = getViewFromWorldMatrix() * endWorld;

        vec4 control = getCustom2();
        float side = control.x;
        float cap = control.y;
        bool startEndpoint = control.z < 0.5;
        float nearPlane = max(materialParams.nearPlane, 0.0001);
        float nearZ = -nearPlane;
        bool lineVisible = clipLineToNearPlane(startView, endView, nearZ);
        highp vec4 clipStart = lineVisible ? getClipFromViewMatrix() * startView :
                vec4(1000000.0, 1000000.0, 0.0, 1.0);
        highp vec4 clipEnd = lineVisible ? getClipFromViewMatrix() * endView : clipStart;
        highp vec4 baseClip = startEndpoint ? clipStart : clipEnd;

        vec2 resolution = max(getResolution().xy, vec2(1.0));
        vec2 startNdc = clipStart.xy / max(abs(clipStart.w), 0.000001);
        vec2 endNdc = clipEnd.xy / max(abs(clipEnd.w), 0.000001);
        vec2 directionPixels = (endNdc - startNdc) * resolution * 0.5;
        float directionLength = length(directionPixels);
        bool endOn = directionLength <= 0.0001;
        vec2 direction = !endOn ? directionPixels / directionLength : vec2(1.0, 0.0);
        vec2 normal = vec2(-direction.y, direction.x);

        float sideDistance = (max(materialParams.lineWidth, 1.0) + max(materialParams.featherPixels, 0.0)) * 0.5;
        vec2 offsetPixels = (normal * side + direction * cap) * sideDistance;
        vec2 offsetDevice = offsetPixels * getResolution().zw * 2.0;
        float reciprocalW = 1.0 / max(abs(baseClip.w), 0.000001);
        highp vec3 baseDevice = baseClip.xyz * reciprocalW;

        // DEVICE-domain vertices are remapped by Filament from OpenGL NDC Z
        // to reversed depth. Convert clipFromView's already-reversed depth
        // back to OpenGL NDC so that remap happens exactly once.
        float startDepth = clipStart.z / max(abs(clipStart.w), 0.000001);
        float endDepth = clipEnd.z / max(abs(clipEnd.w), 0.000001);
        // Cap vertices sit beyond the original endpoints. Extend the depth
        // plane by that same screen-space distance so the interior retains
        // its original projected depth instead of stretching over the caps.
        float ribbonDepth = endOn ? max(startDepth, endDepth) :
                baseDevice.z + cap * sideDistance * (endDepth - startDepth) / directionLength;
        float deviceDepth = 1.0 - 2.0 * ribbonDepth;
        // Use a fixed view-space pull, bounded by the previous maximum. One
        // conservative offset for both endpoints is intentional: DEVICE
        // ribbons interpolate depth linearly on screen, so different endpoint
        // offsets could overtake occluders along a long slanted segment.
        float depthBiasUnits = max(materialParams.depthBias, 0.0);
        highp vec4 farView = startView.z < endView.z ? startView : endView;
        highp vec4 farClip = getClipFromViewMatrix() * farView;
        highp vec4 biasedView = farView;
        biasedView.z = min(farView.z + 0.04 * depthBiasUnits, nearZ);
        highp vec4 biasedClip = getClipFromViewMatrix() * biasedView;
        float farDepth = farClip.z / max(abs(farClip.w), 0.000001);
        float biasedDepth = biasedClip.z / max(abs(biasedClip.w), 0.000001);
        float legacyMaximumPull = depthBiasUnits * nearPlane * 0.0025;
        float deviceOffset = min(legacyMaximumPull, max(0.0, 2.0 * (biasedDepth - farDepth)));
        // Let the hardware clip extrapolated caps at the near/far planes.
        // Clamping individual vertices here would bend the interior depth
        // plane again, particularly when an endpoint was near-clipped.
        deviceDepth -= deviceOffset;
        highp vec4 finalDevice = vec4(baseDevice.xy + offsetDevice,
                                     deviceDepth, 1.0);

        material.clipSpaceTransform = mat4(1.0);
        material.clipSpaceTransform[3] = finalDevice;
        float halfLengthPixels = directionLength * 0.5;
        material.lineDistancePixels = vec4(side * sideDistance,
                cap * (halfLengthPixels + sideDistance), halfLengthPixels,
                ribbonDepth + deviceOffset * 0.5);
        material.lineSurfaceDepths = vec4(0.0);
        if (materialParams.surfaceDepthEnabled) {
            highp vec4 support0World = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom3().xyz), 1.0);
            highp vec4 support1World = getWorldFromModelMatrix() * vec4(overlayPosition(getCustom4().xyz), 1.0);
            highp vec4 support0Clip = getClipFromViewMatrix() * getViewFromWorldMatrix() * support0World;
            highp vec4 support1Clip = getClipFromViewMatrix() * getViewFromWorldMatrix() * support1World;
            material.lineSurfaceDepths = vec4(
                    surfaceDepth(clipStart, clipEnd, support0Clip, finalDevice.xy, ribbonDepth) + deviceOffset * 0.5,
                    surfaceDepth(clipStart, clipEnd, support1Clip, finalDevice.xy, ribbonDepth) + deviceOffset * 0.5,
                    0.0, 0.0);
        }
    }
}

fragment {
    #include "overlay_line_coverage.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float alphaScale = overlayLineCoverage(variable_lineDistancePixels.xyz,
                materialParams.lineWidth, materialParams.featherPixels);

        if (materialParams.dashPeriodPixels > 0.0) {
            // DEVICE ribbons have W=1, so this coordinate stays linear in
            // physical pixels across perspective depth changes and caps.
            // Center the first dash at the near-clipped start for short spans.
            float distancePixels = variable_lineDistancePixels.y + variable_lineDistancePixels.z;
            float period = materialParams.dashPeriodPixels;
            float phase = mod(distancePixels + period * 0.5, period) - period * 0.5;
            float dashDistance = abs(phase) - period * saturate(materialParams.dashFactor) * 0.5;
            float feather = max(fwidth(distancePixels), 0.0001);
            alphaScale *= saturate(0.5 - dashDistance / feather);
        }

        // Explicit depth preserves reverse-Z precision and a source face's
        // full solid ribbon width. The default path retains rasterized depth.
        gl_FragDepth = materialParams.surfaceDepthEnabled
                ? max(variable_lineDistancePixels.w,
                        max(variable_lineSurfaceDepths.x, variable_lineSurfaceDepths.y))
                : gl_FragCoord.z;

        vec4 color = getColor();
        color.a *= alphaScale * saturate(materialParams.alphaMultiplier);
        if (color.a <= 0.0) {
            discard;
        }
        material.baseColor = vec4(color.rgb * color.a, color.a);
    }
}
