material {
    name : QuaderDefaultMesh,
    blending : transparent,
    depthWrite : true,
    instanced : true,
    shadingModel : unlit,
    requires : [
        uv0,
        tangents,
        custom0
    ],
    variables : [
        surfaceGridProjection
    ],
    parameters : [
        {
            type : sampler2d,
            name : baseColorTexture
        },
        {
            type : float4,
            name : baseColorFactor
        },
        {
            type : float2,
            name : textureTransformCenter
        },
        {
            type : float2,
            name : textureTransformScale
        },
        {
            type : float2,
            name : textureTransformOffset
        },
        {
            type : float,
            name : textureTransformRotationRadians
        },
        {
            type : float,
            name : shadedLightingEnabled
        },
        {
            type : float,
            name : shadedKeyDirectionX
        },
        {
            type : float,
            name : shadedKeyDirectionY
        },
        {
            type : float,
            name : shadedKeyDirectionZ
        },
        {
            type : float,
            name : shadedKeyIntensity
        },
        {
            type : float,
            name : shadedDiffuseWrap
        },
        {
            type : float,
            name : shadedGroundFill
        },
        {
            type : float,
            name : shadedSkyFill
        },
        {
            type : float4,
            name : surfaceGridMinorColor
        },
        {
            type : float4,
            name : surfaceGridMajorColor
        },
        {
            type : float,
            name : surfaceGridSize
        },
        {
            type : float,
            name : surfaceGridMajorSize
        },
        {
            type : float,
            name : surfaceGridMinorLineThickness
        },
        {
            type : float,
            name : surfaceGridMajorLineThickness
        },
        {
            type : float,
            name : surfaceGridEnabled
        },
        {
            type : float,
            name : instanceEditDim
        },
        {
            type : float4,
            name : instanceEditContextColor
        }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec4 projection = getCustom0();
        vec3 worldNormal = getWorldFromModelNormalMatrix() * projection.xyz;
        float normalLengthSquared = dot(worldNormal, worldNormal);
        material.surfaceGridProjection = vec4(
                normalLengthSquared > 0.000001
                        ? worldNormal * inversesqrt(normalLengthSquared)
                        : vec3(0.0, 1.0, 0.0),
                projection.w);
    }
}

fragment {
    float surfaceGridFloor(float spacing) {
        return exp2(floor(log2(max(spacing, 0.0001))));
    }

    float surfaceGridLineCoverage(float coord, float spacing, float thicknessValue) {
        float safeSpacing = max(spacing, 0.0001);
        float wrapped = abs(fract(coord / safeSpacing + 0.5) - 0.5) * safeSpacing;
        float thickness = clamp(thicknessValue, 0.05, 8.0);
        float derivativeWidth = fwidth(coord);
        float antialias = clamp(derivativeWidth, safeSpacing * 0.0005, safeSpacing * 0.125);
        float lineWidth = min(antialias * 0.75 * thickness, safeSpacing * 0.125);
        float feather = min(antialias, safeSpacing * 0.125);
        return 1.0 - smoothstep(lineWidth, lineWidth + feather, wrapped);
    }

    float surfaceGridLine(float coord, float spacing, float thicknessValue, float worldPixelWidth) {
        float safeSpacing = max(spacing, 0.0001);
        float minRenderableSpacing = max(worldPixelWidth, 0.0) * 4.0;
        float lodSpacing = max(surfaceGridFloor(max(minRenderableSpacing, safeSpacing)), safeSpacing);
        float nextSpacing = max(lodSpacing * 2.0, lodSpacing + 0.0001);
        float blend = smoothstep(lodSpacing, nextSpacing, minRenderableSpacing);
        float currentCoverage = surfaceGridLineCoverage(coord, lodSpacing, thicknessValue);
        float nextCoverage = surfaceGridLineCoverage(coord, nextSpacing, thicknessValue);
        return mix(currentCoverage, nextCoverage, blend);
    }

    float surfaceGridLineSlotCoverage(
            float coord, float spacing, float thicknessValue, float worldPixelWidth) {
        float safeSpacing = max(spacing, 0.0001);
        float minRenderableSpacing = max(worldPixelWidth, 0.0) * 4.0;
        float lodSpacing = max(surfaceGridFloor(max(minRenderableSpacing, safeSpacing)), safeSpacing);
        float nextSpacing = max(lodSpacing * 2.0, lodSpacing + 0.0001);
        float currentCoverage = surfaceGridLineCoverage(coord, lodSpacing, thicknessValue);
        float nextCoverage = surfaceGridLineCoverage(coord, nextSpacing, thicknessValue);
        return max(currentCoverage, nextCoverage);
    }

    vec3 surfaceGridProjectionWeights(vec3 normal) {
        // Blend line coverage instead of coordinates so curved smooth meshes
        // transition between world projection planes without seams or stubs.
        vec3 weights = abs(normal);
        weights *= weights;
        weights *= weights;
        float weightSum = weights.x + weights.y + weights.z;
        if (weightSum <= 0.000001) {
            return vec3(0.0, 0.0, 1.0);
        }
        return weights / weightSum;
    }

    vec3 surfaceGridFaceProjectionWeights(vec3 normal) {
        // TrenchBroom is Z-up. After conversion to Quader's Y-up coordinates,
        // strict dominant-axis ties resolve Y, then Z, then X.
        vec3 dominant = abs(normal);
        if (dominant.x > dominant.y && dominant.x > dominant.z) {
            return vec3(1.0, 0.0, 0.0);
        }
        if (dominant.z > dominant.y) {
            return vec3(0.0, 0.0, 1.0);
        }
        return vec3(0.0, 1.0, 0.0);
    }

    vec3 surfaceGridPlaneLineCoverages(
            highp vec3 worldPosition,
            float spacing,
            float thicknessValue,
            float worldPixelWidth) {
        vec3 axisCoverages = vec3(
                surfaceGridLine(worldPosition.x, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLine(worldPosition.y, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLine(worldPosition.z, spacing, thicknessValue, worldPixelWidth));
        return vec3(
                max(axisCoverages.y, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.y));
    }

    vec3 surfaceGridPlaneSlotCoverages(
            highp vec3 worldPosition,
            float spacing,
            float thicknessValue,
            float worldPixelWidth) {
        vec3 axisCoverages = vec3(
                surfaceGridLineSlotCoverage(worldPosition.x, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLineSlotCoverage(worldPosition.y, spacing, thicknessValue, worldPixelWidth),
                surfaceGridLineSlotCoverage(worldPosition.z, spacing, thicknessValue, worldPixelWidth));
        return vec3(
                max(axisCoverages.y, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.z),
                max(axisCoverages.x, axisCoverages.y));
    }

    vec3 applySurfaceGrid(vec3 baseColor) {
        if (materialParams.surfaceGridEnabled <= 0.5) {
            return baseColor;
        }

        highp vec3 worldPosition = getUserWorldPosition().xyz;
        highp vec3 rasterWorldPosition = getWorldPosition();
        float worldPixelWidth = max(
                length(dFdx(rasterWorldPosition)),
                length(dFdy(rasterWorldPosition)));
        float baseSpacing = max(materialParams.surfaceGridSize, 0.0001);
        float majorSpacing = max(materialParams.surfaceGridMajorSize, baseSpacing);
        vec4 faceProjection = variable_surfaceGridProjection;
        vec3 projectionWeights = faceProjection.w > 0.5
                ? surfaceGridFaceProjectionWeights(faceProjection.xyz)
                : surfaceGridProjectionWeights(
                        getWorldGeometricNormalVector());
        vec3 minorPlaneCoverages = surfaceGridPlaneLineCoverages(
                worldPosition, baseSpacing,
                materialParams.surfaceGridMinorLineThickness,
                worldPixelWidth);
        vec3 majorPlaneCoverages = surfaceGridPlaneLineCoverages(
                worldPosition, majorSpacing,
                materialParams.surfaceGridMajorLineThickness,
                worldPixelWidth);

        float majorSlotThickness = max(
                materialParams.surfaceGridMinorLineThickness,
                materialParams.surfaceGridMajorLineThickness);
        vec3 majorSlotCoverages = surfaceGridPlaneSlotCoverages(
                worldPosition, majorSpacing, majorSlotThickness,
                worldPixelWidth);
        vec3 majorSlotMask = step(vec3(0.000001), majorSlotCoverages);
        float minorLine = dot(
                minorPlaneCoverages * (vec3(1.0) - majorSlotMask),
                projectionWeights);
        float majorLine = dot(majorPlaneCoverages, projectionWeights);

        float majorCoverage = majorLine * materialParams.surfaceGridMajorColor.a;
        float minorCoverage =
                minorLine * materialParams.surfaceGridMinorColor.a;
        float alpha = clamp(minorCoverage + majorCoverage, 0.0, 1.0);
        if (alpha <= 0.000001) {
            return baseColor;
        }
        vec3 gridColor = (materialParams.surfaceGridMinorColor.rgb * minorCoverage
                + materialParams.surfaceGridMajorColor.rgb * majorCoverage) / alpha;
        return mix(baseColor, gridColor, alpha);
    }

    vec2 applyTextureTransform(vec2 uv) {
        vec2 local = (uv - materialParams.textureTransformCenter)
                * materialParams.textureTransformScale;
        float cosine = cos(materialParams.textureTransformRotationRadians);
        float sine = sin(materialParams.textureTransformRotationRadians);
        vec2 rotated = vec2(
                cosine * local.x - sine * local.y,
                sine * local.x + cosine * local.y);
        return materialParams.textureTransformCenter + rotated
                + materialParams.textureTransformOffset;
    }

    vec4 applyInstanceEditDim(vec3 baseColor, float sourceAlpha) {
        float amount = clamp(materialParams.instanceEditDim, 0.0, 1.0);
        float luminance = dot(baseColor, vec3(0.2126, 0.7152, 0.0722));
        vec3 contextColor = mix(vec3(luminance),
                                materialParams.instanceEditContextColor.rgb,
                                0.88);
        float contextAlpha = clamp(materialParams.instanceEditContextColor.a,
                                   0.05, 1.0);
        return vec4(mix(baseColor, contextColor, amount),
                    mix(sourceAlpha, contextAlpha, amount));
    }

    float shadedModelingLighting() {
        vec3 normalWorld = normalize(getWorldNormalVector());
        vec3 normalView = normalize(
                (getViewFromWorldMatrix() * vec4(normalWorld, 0.0)).xyz);
        vec3 keyDirectionInput = clamp(
                vec3(materialParams.shadedKeyDirectionX,
                     materialParams.shadedKeyDirectionY,
                     materialParams.shadedKeyDirectionZ),
                vec3(-1.0), vec3(1.0));
        float keyDirectionLengthSquared = dot(
                keyDirectionInput, keyDirectionInput);
        vec3 keyDirectionView = keyDirectionLengthSquared > 0.000001
                ? keyDirectionInput * inversesqrt(keyDirectionLengthSquared)
                : normalize(vec3(-0.09, 0.47, 0.88));
        vec3 worldUp = vec3(0.0, 1.0, 0.0);

        float keyIntensity = max(materialParams.shadedKeyIntensity, 0.0);
        float diffuseWrap = clamp(materialParams.shadedDiffuseWrap, 0.0, 0.8);
        float groundFill = clamp(materialParams.shadedGroundFill, 0.0, 1.0);
        float skyFill = clamp(materialParams.shadedSkyFill, 0.0, 1.0);

        float wrappedDiffuse = clamp(
                (dot(normalView, keyDirectionView) + diffuseWrap)
                        / (1.0 + diffuseWrap),
                0.0, 1.0);
        float hemisphereT = clamp(
                dot(normalWorld, worldUp) * 0.5 + 0.5,
                0.0, 1.0);
        float ambient = mix(groundFill, skyFill, hemisphereT);
        return min(ambient + keyIntensity * wrappedDiffuse, 1.0);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = applyTextureTransform(
                vec2(getUV0().x, 1.0 - getUV0().y));
        vec4 baseSample = texture(materialParams_baseColorTexture, uv);
        vec3 baseColor = baseSample.rgb * materialParams.baseColorFactor.rgb;
        float lighting = mix(
                1.0,
                shadedModelingLighting(),
                clamp(materialParams.shadedLightingEnabled, 0.0, 1.0));
        baseColor *= lighting;
        baseColor = applySurfaceGrid(baseColor);
        vec4 edited = applyInstanceEditDim(
                baseColor, baseSample.a * materialParams.baseColorFactor.a);
        material.baseColor = vec4(edited.rgb * edited.a, edited.a);
    }
}
