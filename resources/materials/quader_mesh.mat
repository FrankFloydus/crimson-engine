material {
    name : QuaderDefaultMesh,
    shadingModel : unlit,
    requires : [
        uv0
    ],
    parameters : [
        {
            type : sampler2d,
            name : baseColorTexture
        },
        {
            type : sampler2d,
            name : roughnessTexture
        },
        {
            type : float4,
            name : baseColorFactor
        },
        {
            type : float,
            name : metallicFactor
        },
        {
            type : float,
            name : roughnessFactor
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = vec2(getUV0().x, 1.0 - getUV0().y);
        vec4 baseSample = texture(materialParams_baseColorTexture, uv);
        vec3 baseColor = baseSample.rgb * materialParams.baseColorFactor.rgb;

        material.baseColor = vec4(baseColor, baseSample.a * materialParams.baseColorFactor.a);
    }
}
