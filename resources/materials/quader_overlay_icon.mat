material {
    name : QuaderOverlayIcon,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    doubleSided : true,
    vertexDomain : device,
    requires : [
        uv0,
        color
    ],
    parameters : [
        {
            type : sampler2d,
            name : iconTexture
        }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // ViewportRenderer supplies visible-to-backing NDC in global 1. Other
        // views retain Filament's default global, which means identity here.
        vec4 presentation = getMaterialGlobal1();
        if (presentation.x > 0.0 && presentation.y > 0.0) {
            material.clipSpaceTransform = mat4(1.0);
            material.clipSpaceTransform[0][0] = presentation.x;
            material.clipSpaceTransform[1][1] = presentation.y;
            material.clipSpaceTransform[3].xy = presentation.zw;
        }
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 sampled = texture(materialParams_iconTexture, getUV0());
        vec4 tint = getColor();
        float alpha = sampled.a * tint.a;
        if (alpha <= 0.003) {
            discard;
        }
        material.baseColor = vec4(sampled.rgb * tint.rgb * alpha, alpha);
    }
}
