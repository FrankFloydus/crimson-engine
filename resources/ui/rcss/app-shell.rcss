body {
    width: 100%;
    height: 100%;
    margin: 0px;
    padding: 0px;
    overflow: hidden;
}

.app-shell {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.shell-bar {
    flex-grow: 0;
    flex-shrink: 0;
    display: flex;
    align-items: center;
}

.shell-toolbar {
    border-bottom-width: 1dp;
}

.shell-statusbar {
    border-top-width: 1dp;
}

.main-layout-slot {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    width: 100%;
    min-height: 1dp;
    overflow: hidden;
}

.main-layout {
    position: relative;
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    width: 100%;
    min-height: 1dp;
    overflow: hidden;
}

.viewport-host {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    min-width: 1dp;
    min-height: 1dp;
    overflow: hidden;
}

.viewport-surface {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}

.main-layout-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-left-width: 1dp;
    overflow: hidden;
}

.main-layout-sidebar-left .main-layout-sidebar {
    border-left-width: 0dp;
    border-right-width: 1dp;
}

.main-layout-sidebar-resizer {
    position: absolute;
    top: 0px;
    width: 12dp;
    height: 100%;
    background-color: transparent;
    z-index: 10;
}

.main-layout-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.main-layout-panel-flex {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
}

.main-layout-panel-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 1dp;
}

.main-layout-panel-resizer {
    position: absolute;
    left: 0px;
    width: 100%;
    height: 12dp;
    background-color: transparent;
    z-index: 10;
}

.main-layout-resizer-base-line {
    position: absolute;
}

.main-layout-resizer-base-line-vertical {
    left: 6dp;
    top: 0px;
    width: 1dp;
    height: 100%;
}

.main-layout-resizer-base-line-horizontal {
    left: 0px;
    top: 6dp;
    width: 100%;
    height: 1dp;
}

.main-layout-resizer-drag-line {
    position: absolute;
    opacity: 0;
    transition: opacity 0.12s sine-out;
}

.main-layout-resizer-drag-line-vertical {
    left: 5dp;
    top: 0px;
    width: 3dp;
    height: 100%;
}

.main-layout-sidebar-resizer-collapsed .main-layout-resizer-base-line {
    opacity: 0;
}

.main-layout-sidebar-resizer-collapsed-left .main-layout-resizer-drag-line-vertical {
    left: 0dp;
}

.main-layout-sidebar-resizer-collapsed-right .main-layout-resizer-drag-line-vertical {
    left: 9dp;
}

.main-layout-resizer-drag-line-horizontal {
    left: 0px;
    top: 5dp;
    width: 100%;
    height: 3dp;
}

.main-layout-sidebar-resizer:hover .main-layout-resizer-drag-line,
.main-layout-sidebar-resizer:active .main-layout-resizer-drag-line,
.main-layout-panel-resizer:hover .main-layout-resizer-drag-line,
.main-layout-panel-resizer:active .main-layout-resizer-drag-line,
.main-layout-resizer-active .main-layout-resizer-drag-line {
    opacity: 1;
}

#debug-palette-page {
    display: none;
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    overflow: auto;
}

.debug-palette-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.debug-palette-token {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.debug-palette-swatch {
    flex-grow: 0;
    flex-shrink: 0;
}

.debug-palette-text {
    display: flex;
    flex-direction: column;
}

.debug-palette-hex {
    text-align: left;
}

.debug-palette-hex:hover {
    background-color: #3C3C3C;
    border-color: #838383;
}

.debug-palette-hex:active {
    background-color: #5B5B5B;
    border-color: #B4B4B4;
}
