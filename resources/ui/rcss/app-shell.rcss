body {
    width: 100%;
    height: 100%;
    margin: 0px;
    padding: 0px;
    overflow: hidden;
}

.app-shell {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.shell-bar {
    flex-grow: 0;
    flex-shrink: 0;
    display: flex;
    align-items: center;
}

.shell-toolbar {
    border-bottom-width: 1dp;
}

.shell-statusbar {
    border-top-width: 1dp;
}

.main-layout-slot {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    width: 100%;
    min-height: 1dp;
    overflow: hidden;
}

.main-layout {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    width: 100%;
    min-height: 1dp;
    overflow: hidden;
}

.main-layout-main-row {
    position: relative;
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    width: 100%;
    min-height: 1dp;
    overflow: hidden;
}

.main-layout-editor-column {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    min-width: 1dp;
    min-height: 1dp;
    overflow: hidden;
}

.viewport-host {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
    min-width: 1dp;
    min-height: 1dp;
    overflow: hidden;
}

.viewport-surface {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}

.main-layout-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
}

.main-layout-side-dock-left {
    border-left-width: 0dp;
    border-right-width: 1dp;
}

.main-layout-side-dock-right {
    border-left-width: 1dp;
    border-right-width: 0dp;
}

.main-layout-sidebar-resizer {
    position: absolute;
    top: 0px;
    width: 12dp;
    height: 100%;
    background-color: transparent;
    z-index: 10;
}

.main-layout-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.main-layout-panel-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    height: 32dp;
    padding-left: 12dp;
    padding-right: 8dp;
    border-bottom-width: 1dp;
    overflow: hidden;
}

.main-layout-panel-title {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.main-layout-panel-drag-source .main-layout-panel-body {
    opacity: 0.48;
}

.main-layout-panel-header-drag-source {
    opacity: 0.72;
}

.main-layout-panel-drop-overlay {
    position: absolute;
    min-height: 22dp;
    min-width: 22dp;
    opacity: 0.32;
    z-index: 12;
}

.main-layout-panel-drop-overlay-vertical {
    left: 0px;
    width: 100%;
    height: 50%;
}

.main-layout-panel-drop-overlay-vertical-before {
    top: 0px;
}

.main-layout-panel-drop-overlay-vertical-after {
    bottom: 0px;
}

.main-layout-panel-drop-overlay-horizontal {
    top: 0px;
    width: 50%;
    height: 100%;
}

.main-layout-panel-drop-overlay-horizontal-before {
    left: 0px;
}

.main-layout-panel-drop-overlay-horizontal-after {
    right: 0px;
}

.main-layout-panel-flex {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0dp;
}

.main-layout-panel-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 1dp;
}

.main-layout-bottom-dock {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-top-width: 1dp;
    overflow: hidden;
}

.main-layout-tab-strip {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    height: 32dp;
    border-bottom-width: 1dp;
    overflow: hidden;
}

.main-layout-tab {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 84dp;
    max-width: 180dp;
    padding-left: 12dp;
    padding-right: 12dp;
    border-right-width: 1dp;
    overflow: hidden;
}

.main-layout-tab-active {
    flex-shrink: 0;
}

.main-layout-tab-drag-source {
    opacity: 0.72;
}

.main-layout-tab-title {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.main-layout-tab-drop-insertion-line {
    position: absolute;
    top: 4dp;
    width: 2dp;
    height: 24dp;
    z-index: 12;
}

.main-layout-tab-drop-insertion-line-before {
    left: -1dp;
}

.main-layout-tab-drop-insertion-line-after {
    right: -1dp;
}

.main-layout-bottom-dock-content {
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 1dp;
    overflow: hidden;
}

.main-layout-bottom-panel-pane {
    min-width: 120dp;
    border-right-width: 1dp;
}

.main-layout-bottom-split-resizer {
    position: relative;
    width: 0dp;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: transparent;
    overflow: visible;
    z-index: 10;
}

.main-layout-bottom-split-resizer .main-layout-resizer-base-line {
    opacity: 0;
}

.main-layout-bottom-split-resizer .main-layout-resizer-drag-line-vertical {
    left: -1dp;
}

.main-layout-panel-resizer {
    position: absolute;
    left: 0px;
    width: 100%;
    height: 12dp;
    background-color: transparent;
    z-index: 10;
}

.main-layout-bottom-dock-resizer {
    position: absolute;
    left: 0px;
    width: 100%;
    height: 12dp;
    background-color: transparent;
    z-index: 10;
}

.main-layout-bottom-dock-resizer-collapsed .main-layout-resizer-base-line {
    opacity: 0;
}

.main-layout-resizer-base-line {
    position: absolute;
}

.main-layout-resizer-base-line-vertical {
    left: 6dp;
    top: 0px;
    width: 1dp;
    height: 100%;
}

.main-layout-resizer-base-line-horizontal {
    left: 0px;
    top: 6dp;
    width: 100%;
    height: 1dp;
}

.main-layout-resizer-drag-line {
    position: absolute;
    opacity: 0;
    transition: opacity 0.12s sine-out;
}

.main-layout-resizer-drag-line-vertical {
    left: 5dp;
    top: 0px;
    width: 3dp;
    height: 100%;
}

.main-layout-sidebar-resizer-collapsed .main-layout-resizer-base-line {
    opacity: 0;
}

.main-layout-sidebar-resizer-collapsed-left .main-layout-resizer-drag-line-vertical {
    left: 0dp;
}

.main-layout-sidebar-resizer-collapsed-right .main-layout-resizer-drag-line-vertical {
    left: 9dp;
}

.main-layout-resizer-drag-line-horizontal {
    left: 0px;
    top: 5dp;
    width: 100%;
    height: 3dp;
}

.main-layout-sidebar-resizer:hover .main-layout-resizer-drag-line,
.main-layout-sidebar-resizer:active .main-layout-resizer-drag-line,
.main-layout-panel-resizer:hover .main-layout-resizer-drag-line,
.main-layout-panel-resizer:active .main-layout-resizer-drag-line,
.main-layout-bottom-dock-resizer:hover .main-layout-resizer-drag-line,
.main-layout-bottom-dock-resizer:active .main-layout-resizer-drag-line,
.main-layout-bottom-split-resizer:hover .main-layout-resizer-drag-line,
.main-layout-bottom-split-resizer:active .main-layout-resizer-drag-line,
.main-layout-resizer-active .main-layout-resizer-drag-line {
    opacity: 1;
}

.main-layout-sidebar-drop-indicator {
    position: absolute;
    top: 0px;
    width: 4dp;
    height: 100%;
    z-index: 12;
}

.main-layout-sidebar-drop-indicator-left {
    left: 0px;
}

.main-layout-sidebar-drop-indicator-right {
    right: 0px;
}

.main-layout-bottom-dock-drop-indicator {
    position: absolute;
    left: 0px;
    bottom: 0px;
    width: 100%;
    height: 4dp;
    z-index: 12;
}

.main-layout-dock-drag-preview {
    position: absolute;
    width: 176dp;
    height: 32dp;
    border-width: 1dp;
    opacity: 0.72;
    z-index: 13;
    overflow: hidden;
}

.main-layout-dock-drag-preview-title {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#debug-palette-page {
    display: none;
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    overflow: auto;
}

.debug-palette-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.debug-palette-token {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.debug-palette-swatch {
    flex-grow: 0;
    flex-shrink: 0;
}

.debug-palette-text {
    display: flex;
    flex-direction: column;
}

.debug-palette-hex {
    text-align: left;
}

.debug-palette-hex:hover {
    background-color: #3C3C3C;
    border-color: #838383;
}

.debug-palette-hex:active {
    background-color: #5B5B5B;
    border-color: #B4B4B4;
}
