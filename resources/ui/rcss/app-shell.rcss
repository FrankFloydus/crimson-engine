body {
    width: 100%;
    height: 100%;
    margin: 0px;
    padding: 0px;
    overflow: hidden;
}

.viewport-panel {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.viewport-surface {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}

#debug-palette-page {
    display: none;
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    overflow: auto;
}

.debug-palette-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.debug-palette-token {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.debug-palette-swatch {
    flex-grow: 0;
    flex-shrink: 0;
}

.debug-palette-text {
    display: flex;
    flex-direction: column;
}

.debug-palette-hex {
    text-align: left;
}

.debug-palette-hex:hover {
    background-color: #3C3C3C;
    border-color: #838383;
}

.debug-palette-hex:active {
    background-color: #5B5B5B;
    border-color: #B4B4B4;
}
