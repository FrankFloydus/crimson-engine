# Keep one complete paired runtime payload current independently of executable
# relinking. COPY_FILE ONLY_IF_DIFFERENT also leaves unchanged loaded DLLs alone.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED CC_READER_SOURCE OR NOT DEFINED CC_READER_DESTINATION)
    message(FATAL_ERROR "Quader staging requires its source and destination directories.")
endif()
file(REAL_PATH "${CC_READER_SOURCE}" reader_source)
get_filename_component(reader_destination "${CC_READER_DESTINATION}" ABSOLUTE)
if(EXISTS "${reader_destination}")
    file(REAL_PATH "${reader_destination}" reader_destination)
endif()
get_filename_component(destination_name "${reader_destination}" NAME)
cmake_path(IS_PREFIX reader_source "${reader_destination}" NORMALIZE destination_in_source)
cmake_path(IS_PREFIX reader_destination "${reader_source}" NORMALIZE source_in_destination)
if(NOT destination_name STREQUAL "quader-reader" OR destination_in_source OR source_in_destination)
    message(FATAL_ERROR "Quader staging must use a separate executable-local quader-reader directory.")
endif()
foreach(required IN ITEMS quader_bridge_reader.dll include/quader_bridge_reader.hpp)
    if(NOT EXISTS "${reader_source}/${required}")
        message(FATAL_ERROR "The paired Quader reader payload is missing ${required}.")
    endif()
endforeach()
file(GLOB_RECURSE payload_files RELATIVE "${reader_source}" LIST_DIRECTORIES FALSE "${reader_source}/*")
file(MAKE_DIRECTORY "${reader_destination}")
file(GLOB_RECURSE staged_files RELATIVE "${reader_destination}" LIST_DIRECTORIES FALSE "${reader_destination}/*")
foreach(staged IN LISTS staged_files)
    if(NOT staged IN_LIST payload_files)
        file(REMOVE "${reader_destination}/${staged}")
    endif()
endforeach()
foreach(payload IN LISTS payload_files)
    get_filename_component(parent "${reader_destination}/${payload}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${reader_source}/${payload}" "${reader_destination}/${payload}" ONLY_IF_DIFFERENT)
endforeach()
