cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS ENGINE_READER_FILE ENGINE_READER_HEADER ENGINE_READER_DESTINATION)
    if(NOT DEFINED ${required} OR NOT IS_ABSOLUTE "${${required}}")
        message(FATAL_ERROR "Engine reader staging requires an absolute ${required}.")
    endif()
endforeach()
get_filename_component(destination_name "${ENGINE_READER_DESTINATION}" NAME)
if(NOT destination_name STREQUAL "quader-reader")
    message(FATAL_ERROR "Engine reader staging requires the executable-local quader-reader directory.")
endif()
file(MAKE_DIRECTORY "${ENGINE_READER_DESTINATION}/include")
file(COPY_FILE "${ENGINE_READER_FILE}" "${ENGINE_READER_DESTINATION}/quader_bridge_reader.dll" ONLY_IF_DIFFERENT)
file(COPY_FILE "${ENGINE_READER_HEADER}" "${ENGINE_READER_DESTINATION}/include/quader_bridge_reader.hpp" ONLY_IF_DIFFERENT)
foreach(dependency IN LISTS ENGINE_READER_DEPENDENCIES)
    get_filename_component(name "${dependency}" NAME)
    file(COPY_FILE "${dependency}" "${ENGINE_READER_DESTINATION}/${name}" ONLY_IF_DIFFERENT)
endforeach()
