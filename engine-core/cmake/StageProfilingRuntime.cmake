file(MAKE_DIRECTORY "${ENGINE_PROFILE_DESTINATION}")
file(COPY_FILE "${ENGINE_PROFILE_BROKER}" "${ENGINE_PROFILE_DESTINATION}/crimson-tracy-capture.exe" ONLY_IF_DIFFERENT)
if(DEFINED ENGINE_PROFILE_LICENSE)
    file(COPY_FILE "${ENGINE_PROFILE_LICENSE}" "${ENGINE_PROFILE_DESTINATION}/Tracy-LICENSE.txt" ONLY_IF_DIFFERENT)
endif()
if(NOT EXISTS "${ENGINE_PROFILE_SOURCE}/tracy-tools.json")
    message(STATUS "Paired Tracy tools are not prepared; explicit profiling requests will report the missing tool manifest.")
    return()
endif()
file(READ "${ENGINE_PROFILE_SOURCE}/tracy-tools.json" manifest)
string(JSON version GET "${manifest}" tracy_version)
if(NOT version STREQUAL "0.14.1")
    message(FATAL_ERROR "Profiling requires the paired Tracy 0.14.1 tool payload.")
endif()
string(JSON count LENGTH "${manifest}" files)
if(count LESS 1)
    message(FATAL_ERROR "Profiling payload has no hash-locked files.")
endif()
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${manifest}" files ${index})
    string(JSON expected GET "${manifest}" files "${name}")
    if(IS_ABSOLUTE "${name}" OR name MATCHES "(^|[/\\])\\.\\.([/\\]|$)")
        message(FATAL_ERROR "Invalid profiling payload member: ${name}")
    endif()
    file(SHA256 "${ENGINE_PROFILE_SOURCE}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Profiling payload checksum mismatch: ${name}")
    endif()
    get_filename_component(parent "${ENGINE_PROFILE_DESTINATION}/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${ENGINE_PROFILE_SOURCE}/${name}" "${ENGINE_PROFILE_DESTINATION}/${name}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${ENGINE_PROFILE_SOURCE}/tracy-tools.json" "${ENGINE_PROFILE_DESTINATION}/tracy-tools.json" ONLY_IF_DIFFERENT)
